# Formspree form IDs — create these in your Formspree account (https://formspree.io)
# Three distinct endpoints keep Zugang (waitlist) / Kontakt / Infografik submissions separable for manual triage.
PUBLIC_FORMSPREE_ZUGANG_ID=REPLACE_WITH_FORMSPREE_ID
PUBLIC_FORMSPREE_KONTAKT_ID=REPLACE_WITH_FORMSPREE_ID
PUBLIC_FORMSPREE_INFOGRAFIK_ID=REPLACE_WITH_FORMSPREE_ID

# Analytics — leave unset to disable a snippet entirely (recommended until real properties exist)
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=

# Set once the LiteLLM gateway is live to switch the playground from scripted demo to real inference
PUBLIC_GATEWAY_URL=
