---
import { getCollection, render } from 'astro:content';
import Site from '../../layouts/Site.astro';
import ArtikelUpsell from '../../components/ArtikelUpsell.astro';

export async function getStaticPaths() {
  const artikel = await getCollection('ratgeber');
  return artikel.map((doc) => ({ params: { slug: doc.id }, props: { doc, alle: artikel } }));
}

const { doc, alle } = Astro.props;
const { Content, headings } = await render(doc);

/** Nur H2 ins Inhaltsverzeichnis — H3/H4 machen es bei 1.500 Wörtern unlesbar. */
const gliederung = headings.filter((h) => h.depth === 2);

const verwandt = doc.data.verwandt
  .map((slug) => alle.find((a) => a.id === slug))
  .filter((a) => a !== undefined);

const url = new URL(`/ratgeber/${doc.id}`, Astro.site ?? Astro.url).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: doc.data.title,
    description: doc.data.beschreibung,
    inLanguage: 'de-DE',
    dateModified: doc.data.stand,
    articleSection: doc.data.kategorie,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    author: { '@type': 'Organization', name: 'DataFortress.cloud GmbH', url: 'https://konforme-ki.de' },
    publisher: {
      '@type': 'Organization',
      name: 'Nachweis',
      url: 'https://konforme-ki.de',
      logo: { '@type': 'ImageObject', url: 'https://konforme-ki.de/og-image.svg' },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: 'https://konforme-ki.de' },
      { '@type': 'ListItem', position: 2, name: 'Ratgeber', item: 'https://konforme-ki.de/ratgeber' },
      { '@type': 'ListItem', position: 3, name: doc.data.title, item: url },
    ],
  },
];
---

<Site
  title={doc.data.metaTitle}
  description={doc.data.beschreibung}
  artikel={{ geaendert: doc.data.stand, kategorie: doc.data.kategorie }}
>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(schema)} />

  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <nav aria-label="Brotkrumen" class="kein-druck flex items-center gap-2 font-mono text-xs text-blau-faint">
      <a href="/" class="hover:text-blau">Start</a>
      <span aria-hidden="true">/</span>
      <a href="/ratgeber" class="hover:text-blau">Ratgeber</a>
    </nav>

    <header class="mt-8 pb-8 border-b border-linie">
      <div class="flex flex-wrap items-center gap-3">
        <span class="marke marke-neutral">{doc.data.kategorie}</span>
        <span class="font-mono text-xs text-blau-faint">{doc.data.lesezeit} · Stand: {doc.data.stand}</span>
      </div>
      <h1 class="mt-5 display display-l text-blau">{doc.data.title}</h1>
      <p class="mt-5 text-lg text-blau-soft leading-relaxed">{doc.data.kurz}</p>
    </header>

    {gliederung.length > 2 && (
      <nav aria-label="Inhalt" class="kein-druck mt-10 border border-linie bg-bogen-tief px-6 py-5">
        <p class="marginalie">Inhalt</p>
        <ol class="mt-3 space-y-1.5">
          {gliederung.map((h, i) => (
            <li class="flex gap-3 text-sm">
              <span class="font-mono text-xs text-blau-faint shrink-0 mt-0.5">{String(i + 1).padStart(2, '0')}</span>
              <a href={`#${h.slug}`} class="text-blau-soft hover:text-siegel transition-colors">{h.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="article-body mt-10">
      <Content />
    </div>

    <ArtikelUpsell />

    {verwandt.length > 0 && (
      <section class="kein-druck mt-14">
        <p class="marginalie">Weiterlesen</p>
        <div class="mt-4 divide-y divide-linie border-t border-b border-linie">
          {verwandt.map((a) => (
            <a href={`/ratgeber/${a.id}`} class="group flex items-start justify-between gap-4 py-5 hover:bg-bogen-tief -mx-4 px-4 transition-colors">
              <div>
                <p class="font-display font-bold text-sm text-blau group-hover:text-siegel transition-colors" style="font-variation-settings: 'wdth' 90;">{a.data.title}</p>
                <p class="mt-1.5 text-sm text-blau-soft leading-relaxed">{a.data.kurz}</p>
              </div>
              <span class="shrink-0 text-siegel text-xl leading-none mt-0.5">→</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <p class="kein-druck mt-12 border-l-2 border-linie pl-4 text-xs text-blau-faint leading-relaxed">
      Dieser Beitrag ist ein Informationsangebot und keine Rechtsberatung. Für die Beurteilung Ihres Einzelfalls
      wenden Sie sich an Ihre eigene Rechtsberatung. Stand der dargestellten Rechtslage: {doc.data.stand}.
    </p>
  </article>
</Site>
