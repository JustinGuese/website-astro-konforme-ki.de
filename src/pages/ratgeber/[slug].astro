---
import { getCollection, render } from 'astro:content';
import Site from '../../layouts/Site.astro';
import ArticleLayout from '@justinguese/astro-kit/ArticleLayout.astro';
import { tocFrom } from '@justinguese/astro-kit/lib/article';
import ArtikelUpsell from '../../components/ArtikelUpsell.astro';
import { site } from '../../config/site';
import { formatDeDatum } from '../../lib/format';

export async function getStaticPaths() {
  const artikel = await getCollection('ratgeber');
  return artikel.map((doc) => ({ params: { slug: doc.id }, props: { doc, alle: artikel } }));
}

const { doc, alle } = Astro.props;
const { Content, headings } = await render(doc);

const verwandt = doc.data.related
  .map((slug) => alle.find((a) => a.id === slug))
  .filter((a) => a !== undefined);

const verwandtCards = verwandt.map((a) => ({
  href: `/ratgeber/${a.id}`,
  title: a.data.title,
  description: a.data.kurz,
  cta: 'Lesen',
}));

const url = new URL(`/ratgeber/${doc.id}`, Astro.site ?? Astro.url).href;
const standAnzeige = formatDeDatum(doc.data.updated);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: doc.data.title,
    description: doc.data.description,
    inLanguage: 'de-DE',
    dateModified: doc.data.updated,
    articleSection: doc.data.category,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    author: { '@type': 'Organization', name: site.legalName, url: site.url },
    publisher: {
      '@type': 'Organization',
      name: site.name,
      url: site.url,
      logo: { '@type': 'ImageObject', url: `${site.url}/og-image.svg` },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Ratgeber', item: `${site.url}/ratgeber` },
      { '@type': 'ListItem', position: 3, name: doc.data.title, item: url },
    ],
  },
];
---

<Site
  title={doc.data.metaTitle}
  description={doc.data.description}
  artikel={{ geaendert: doc.data.updated, kategorie: doc.data.category }}
>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(schema)} />

  <ArticleLayout
    title={doc.data.title}
    description={doc.data.kurz}
    breadcrumbs={[{ label: 'Start', href: '/' }, { label: 'Ratgeber', href: '/ratgeber' }, { label: doc.data.title }]}
    breadcrumbLabel="Brotkrumen"
    meta={[`${doc.data.readingTime} Minuten Lesezeit`, `Stand: ${standAnzeige}`]}
    toc={tocFrom(headings)}
    tocTitle="Inhalt"
    related={verwandtCards}
    relatedTitle="Weiterlesen"
    progress={false}
  >
    <span slot="kicker" class="marke marke-neutral">{doc.data.category}</span>

    <Content />

    <Fragment slot="disclaimer">
      <p class="kein-druck mt-12 border-l-2 border-line pl-4 text-xs text-ink-faint leading-relaxed">
        Dieser Beitrag ist ein Informationsangebot und keine Rechtsberatung. Für die Beurteilung Ihres Einzelfalls
        wenden Sie sich an Ihre eigene Rechtsberatung. Stand der dargestellten Rechtslage: {standAnzeige}.
      </p>
    </Fragment>

    <ArtikelUpsell slot="cta" />
  </ArticleLayout>
</Site>
