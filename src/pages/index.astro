    (() => {
      const params = new URLSearchParams(window.location.search);
      let changed = false;

      if (params.get('starthilfe') === '1') {
        document.getElementById('starthilfe-download')?.classList.remove('hidden');
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'block_a_submit', { content_category: 'Funnel' });
          window.gtag('event', 'starthilfe_viewed', { content_category: 'Funnel' });
        }
        if (typeof window.fbq === 'function') {
          window.fbq('track', 'Lead', { content_name: 'Starthilfe' });
        }
        params.delete('starthilfe');
        changed = true;
      }

      if (params.get('fall_eingereicht') === '1') {
        document.getElementById('fall-eingereicht')?.classList.remove('hidden');
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'fall_eingereicht', { content_category: 'Funnel' });
