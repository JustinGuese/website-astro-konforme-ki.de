---
import Site from '../layouts/Site.astro';
import Kette from '../components/Kette.astro';
import Hero from '../components/Hero.astro';
import RekordKarte from '../components/RekordKarte.astro';
import Playground from '../components/Playground.astro';
import LeiterTabelle from '../components/LeiterTabelle.astro';
import Belege from '../components/Belege.astro';
import Kontingent from '../components/Kontingent.astro';
import InfografikForm from '../components/InfografikForm.astro';
import ZugangForm from '../components/ZugangForm.astro';
import { buildChain } from '../lib/kette';
import { SAEULEN } from '../lib/saeulen';
import { frei } from '../lib/kontingent';

/**
 * Reihenfolge folgt der Trichterlogik, nicht der Produktlogik:
 * Schmerz (problem) → kostenloser Einstieg (checkliste) → Lösung
 * (nachweis/playground/saeulen) → Beleg (belege) → Angebot (angebote) →
 * Handlung (zugang). Vertrauens- und Einschränkungsabschnitte
 * (unterlagen, eu-ki-recht, nicht, faq) stehen bewusst NACH dem Formular:
 * vor dem Formular kosten sie Momentum, danach räumen sie Restzweifel ab.
 */
const abschnitte = [
  { id: 'hero', label: 'Einstieg' },
  { id: 'problem', label: 'Das Problem' },
  { id: 'checkliste', label: 'Checkliste' },
  { id: 'nachweis', label: 'Der Nachweis' },
  { id: 'playground', label: 'Playground' },
  { id: 'saeulen', label: 'Die drei Säulen' },
  { id: 'belege', label: 'Stimmen' },
  { id: 'fuer-wen', label: 'Für wen' },
  { id: 'integrationen', label: 'Integrationen' },
  { id: 'angebote', label: 'Angebote' },
  { id: 'zugang', label: 'Zugang' },
  { id: 'unterlagen', label: 'Unterlagen' },
  { id: 'eu-ki-recht', label: 'EU-KI-Recht' },
  { id: 'nicht', label: 'Was es nicht ist' },
  { id: 'faq', label: 'FAQ' },
  { id: 'abschluss', label: 'Abschluss' },
];
const gliedes = buildChain('index', abschnitte);

const szenarien = [
  {
    beruf: 'Steuerberatung',
    problem: '§ 203 Abs. 1 Nr. 3 StGB — Mandantenunterlagen dürfen keinem US-Prozessor ohne belastbaren AVV anvertraut werden.',
  },
  {
    beruf: 'Rechtsanwaltschaft',
    problem: 'Schriftsätze und Mandantenkorrespondenz enthalten Berufsgeheimnisse — ChatGPT ist ohne Zusatzvereinbarung ausgeschlossen.',
  },
  {
    beruf: 'Arzt- / Zahnarztpraxis',
    problem: 'Anamnesen und Befunde sind besondere Kategorien personenbezogener Daten nach Art. 9 DSGVO, zusätzlich zu § 203.',
  },
];

const exporte = [
  { titel: 'Art. 30 VVT-Eintrag', beschreibung: 'Automatisch generierter Eintrag in Ihr Verarbeitungsverzeichnis, pro Anfrage aktualisiert.' },
  { titel: 'AI-Act Art. 12 Logging', beschreibung: 'Protokollierungsformat, vorbereitet auf die Nachweispflichten des AI Act.' },
  { titel: 'Subprozessorenliste', beschreibung: 'Mit Änderungshistorie — jede Änderung eines Subprozessors wird dokumentiert und gemeldet.' },
  { titel: 'Signierter Export', beschreibung: 'Ein Klick: CSV und PDF, kryptografisch signiert, bereit für Ihren Prüfer.' },
];

const nicht = [
  { titel: 'Keine Rechtsberatung', beschreibung: 'Nachweis ersetzt nicht die Prüfung durch Ihre eigene Rechtsberatung im Einzelfall.' },
  { titel: 'Kein Medizinprodukt', beschreibung: 'Der Gateway ist kein Medizinprodukt im Sinne der MDR — er verarbeitet, aber bewertet nicht.' },
  { titel: 'Keine Haftungsübernahme', beschreibung: 'Ihre Berufspflichten bleiben bei Ihnen. Wir liefern die Infrastruktur und den Nachweis dazu.' },
  { titel: 'Kein Vertragsersatz', beschreibung: 'Unser AVV ergänzt, ersetzt aber nicht Ihre eigene Mandantenvereinbarung zur KI-Nutzung.' },
];

const faq = [
  {
    frage: 'Ist Nachweis selbst ein Berufsgeheimnisträger-konformer Subprozessor?',
    antwort: 'Wir sind Ihr Auftragsverarbeiter nach Art. 28 DSGVO und werden im Rahmen der Zusatzvereinbarung nach § 203 Abs. 3 StGB als mitwirkende Person eingebunden — vorausgesetzt, Sie schließen die entsprechende Vereinbarung mit uns ab. Ein Muster liegt unter „Unterlagen".',
  },
  {
    frage: 'Was genau ist im §203-Freigabedossier für €39 enthalten?',
    antwort: 'AVV-Vorlage nach Art. 28 DSGVO, die §203-Zusatzvereinbarung, ein vorausgefüllter Art. 30 VVT-Eintrag, eine DSB-Freigabevorlage mit vorformuliertem Begründungstext sowie TOM-Beschreibung und Subprozessorenliste. Alle Dokumente sind ausfüllbar, nicht nur zum Lesen. Der Betrag wird vollständig verrechnet, wenn Sie später ein Compliance-Abo abschließen.',
  },
  {
    frage: 'Warum ist die Checkliste kostenlos, das Dossier aber nicht?',
    antwort: 'Die Checkliste sagt Ihnen, was zu prüfen ist — das sollte niemandem etwas kosten. Das Dossier ist die Arbeit danach: fertige, unterschriftsreife Dokumente, mit denen Sie die Freigabe intern tatsächlich durchbekommen.',
  },
  {
    frage: 'Welche Modelle stehen zur Verfügung?',
    antwort: 'Im Standardfall laufen Ihre Anfragen auf eigener Infrastruktur der DataFortress.cloud GmbH in Frankfurt — ohne externen Subprozessor. Wer stattdessen das günstigere EU-Anbieter-Autorouting wählt (Säule 1), erhält ausschließlich Modelle, die über Scaleway, IONOS AI Model Hub, Mistral AI oder OVHcloud AI Endpoints in der EU gehostet werden. Die genaue Modellliste ist Teil Ihres Onboardings.',
  },
  {
    frage: 'Was passiert, wenn kein EU-Modell verfügbar ist?',
    antwort: 'Die Anfrage schlägt fehl — sie wird nicht außerhalb der EU-Routingliste umgeleitet. Sehen Sie sich das im Playground am Beispiel „Was passiert, wenn ich ein US-Modell anfordere?" an.',
  },
  {
    frage: 'Trainieren Sie auf unseren Daten?',
    antwort: 'Nein. Alle EU-Subprozessoren in unserer Routingliste sind vertraglich zu Zero-Retention bzw. Nicht-Training verpflichtet; das ist Teil unserer Auswahlkriterien.',
  },
  {
    frage: 'Warum sind die Zugangsschlüssel begrenzt?',
    antwort: 'Weil wir jeden Start persönlich begleiten und die §203-Zusatzvereinbarung individuell gegenzeichnen. Das skaliert nicht beliebig, deshalb vergeben wir pro Monat ein festes Kontingent. Ist es ausgeschöpft, rücken Sie auf den Folgemonat.',
  },
  {
    frage: 'Ist der Token-Einstieg wirklich kostenlos?',
    antwort: 'Ja, bis 5 Mio. Token ohne Zahlungsmittel. Danach informieren wir Sie, bevor Kosten entstehen.',
  },
  {
    frage: 'Kann ich Nachweis neben meiner bestehenden KI-Lösung nutzen?',
    antwort: 'Ja — sehen Sie sich den Sidecar-Ansatz unter „Integrationen" an. Sie erhalten die Prüfspur, ohne Ihre bestehende Inferenz zu ersetzen.',
  },
  {
    frage: 'Was kostet ein Machbarkeits-Check?',
    antwort: 'Zwischen €1.900 und €9.000 einmalig, abhängig von Umfang und Anzahl der zu integrierenden Kanäle. Details unter „Angebote".',
  },
];
---

<Site>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify([
    {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      '@id': 'https://konforme-ki.de/#organisation',
      name: 'Nachweis',
      legalName: 'DataFortress.cloud GmbH',
      url: 'https://konforme-ki.de',
      logo: 'https://konforme-ki.de/og-image.svg',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Gewerbestraße 13',
        postalCode: '82064',
        addressLocality: 'Straßlach-Dingharting',
        addressCountry: 'DE',
      },
      areaServed: 'DE',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      '@id': 'https://konforme-ki.de/#website',
      url: 'https://konforme-ki.de',
      name: 'Nachweis',
      inLanguage: 'de-DE',
      publisher: { '@id': 'https://konforme-ki.de/#organisation' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.frage,
        acceptedAnswer: { '@type': 'Answer', text: f.antwort },
      })),
    },
  ])} />

  <Kette gliedes={gliedes} slot="kette" />

  <!-- 1. Hero — der Einstieg ist das Angebot, nicht die Produkttour. -->
  <section id="hero" class="py-14 sm:py-20 border-b border-linie">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Hero
        marginalie="Für Berufsgeheimnisträger nach § 203 StGB"
        primaryCta={{ label: 'Zugang anfragen', href: '/?tarif=compliance#zugang' }}
        secondaryCta={{ label: 'Playground öffnen', href: '/playground' }}
      >
        <Fragment slot="titel">§ 203 StGB verbietet Ihnen ChatGPT. <span class="text-siegel">Nicht die KI.</span></Fragment>
        <Fragment slot="subtitel">
          EU-Inferenz mit lückenloser, exportierbarer Prüfspur — der Nachweis, den Ihr Datenschutzbeauftragter verlangt, bevor er KI in Ihrer Kanzlei oder Praxis freigibt.
        </Fragment>

        <Kontingent slot="hinweis" variante="zeile" />

        <div slot="bullets">
          <span class="marke marke-neutral">Kein US-Fallback</span>
          <span class="marke marke-neutral">Kein Training auf Ihren Daten</span>
          <span class="marke marke-neutral">AVV inklusive</span>
        </div>

        <RekordKarte
          kopf="req_8f2a1c93"
          felder={[
            { schluessel: 'modell', wert: 'nachweis-llm-70b' },
            { schluessel: 'subprozessor', wert: 'Keiner — DataFortress.cloud GmbH', ton: 'gut' },
            { schluessel: 'rechenzentrum', wert: 'Frankfurt, DE · eigenes RZ' },
            { schluessel: 'retention', wert: 'kein Training · 0 Tage' },
            { schluessel: 'tokens_in / out', wert: '412 / 96' },
            { schluessel: 'hash', wert: '7be1c4a9f3d820e6…' },
          ]}
          fuss="Jede Anfrage hinterlässt eine Prüfspur — nicht nur Ihre Rechnung."
        />
      </Hero>
    </div>
  </section>

  <!-- 2. Problem -->
  <section id="problem" class="py-16 sm:py-20 border-b border-linie bg-bogen-tief">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="marginalie mb-3">Das Problem</p>
      <h2 class="display display-l text-blau max-w-3xl">Drei Gründe, warum „einfach ChatGPT nehmen" für Sie keine Option ist.</h2>
      <div class="mt-10 grid md:grid-cols-3 gap-px bg-linie border border-linie">
        <div class="bg-bogen-rein p-6">
          <p class="font-mono text-xs text-sperr font-semibold">§ 203 Abs. 3 StGB</p>
          <p class="mt-2 font-display font-bold text-blau" style="font-variation-settings: 'wdth' 90;">Mitwirkende Personen</p>
          <p class="mt-2 text-sm text-blau-soft leading-relaxed">Ein externer KI-Anbieter darf nur unter engen Voraussetzungen Zugang zu Berufsgeheimnissen erhalten — ohne belastbare Vereinbarung machen Sie sich strafbar.</p>
        </div>
        <div class="bg-bogen-rein p-6">
          <p class="font-mono text-xs text-sperr font-semibold">Art. 28 DSGVO</p>
          <p class="mt-2 font-display font-bold text-blau" style="font-variation-settings: 'wdth' 90;">Kein unterschreibbarer AVV</p>
          <p class="mt-2 text-sm text-blau-soft leading-relaxed">Mit einem US-Anbieter, dessen Verarbeitung Sie nicht auditierbar nachweisen können, lässt sich kein belastbarer Auftragsverarbeitungsvertrag schließen.</p>
        </div>
        <div class="bg-bogen-rein p-6">
          <p class="font-mono text-xs text-sperr font-semibold">Art. 30 DSGVO</p>
          <p class="mt-2 font-display font-bold text-blau" style="font-variation-settings: 'wdth' 90;">Dokumentationspflicht</p>
          <p class="mt-2 text-sm text-blau-soft leading-relaxed">Sie müssen jede Verarbeitung in Ihr Verarbeitungsverzeichnis eintragen können — ein „wir nutzen halt KI" reicht bei einer Prüfung nicht.</p>
        </div>
      </div>
    </div>
  </section>

  <!--
    3. Checkliste — die kostenlose Stufe der Angebotsleiter, bewusst direkt
    hinter dem Schmerz und lange vor der Preistabelle. Einziges Feld: E-Mail.
  -->
  <section id="checkliste" class="py-16 sm:py-20 border-b border-linie">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-[1fr_1.1fr] gap-10 lg:gap-16 items-center">
        <div>
          <div class="flex items-center gap-3 flex-wrap">
            <p class="marginalie">Stufe 01 · kostenlos</p>
            <span class="marke marke-siegel">PDF, eine Seite</span>
          </div>
          <h2 class="mt-3 display display-l text-blau">Bevor Sie irgendetwas kaufen: <span class="text-siegel">prüfen Sie, ob es bei Ihnen überhaupt zulässig ist.</span></h2>
          <p class="mt-5 text-blau-soft leading-relaxed max-w-lg">
            Die 12 Punkte, die Ihr Datenschutzbeauftragter durchgeht, bevor er KI freigibt — AI Act, DSGVO und § 203 StGB auf einer Seite, in der Reihenfolge, in der sie tatsächlich anfallen. Zum Weiterleiten gedacht.
          </p>
          <ul class="mt-6 space-y-2.5">
            {['Keine Registrierung, nur E-Mail', 'Direkt an Ihren DSB weiterleitbar', 'Gilt auch, wenn Sie sich gegen uns entscheiden'].map((punkt) => (
              <li class="flex items-start gap-2.5 text-sm text-blau-soft">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-siegel"></span>
                {punkt}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <InfografikForm
            id="checkliste"
            quelle="startseite"
            next="/?infografik_gesendet=1#checkliste"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Der Nachweis — die größte Fläche der Seite, inkl. Exportformate. -->
  <section id="nachweis" class="py-16 sm:py-24 border-b border-linie bg-bogen-tief">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="marginalie mb-3">Der Nachweis</p>
          <h2 class="display display-l text-blau">Nicht die Tokens sind das Produkt. <span class="text-siegel">Diese Zeile ist es.</span></h2>
          <p class="mt-5 text-blau-soft leading-relaxed max-w-lg">
            Jede EU-Inferenzplattform verkauft Ihnen Tokens und einen PDF-AVV. Keine gibt Ihrem Datenschutzbeauftragten oder Prüfer eine per Anfrage exportierbare Beweiskette. Das ist der Unterschied zwischen „wir sind konform" und „hier ist der Beweis".
          </p>
          <dl class="mt-8 space-y-4 text-sm">
            <div class="flex gap-3">
              <dt class="font-mono text-blau-faint w-32 shrink-0">modell</dt>
              <dd class="text-blau-soft">welches Modell tatsächlich geantwortet hat</dd>
            </div>
            <div class="flex gap-3">
              <dt class="font-mono text-blau-faint w-32 shrink-0">subprozessor</dt>
              <dd class="text-blau-soft">wer die Anfrage verarbeitet hat, namentlich</dd>
            </div>
            <div class="flex gap-3">
              <dt class="font-mono text-blau-faint w-32 shrink-0">hash</dt>
              <dd class="text-blau-soft">verkettet mit der vorherigen Anfrage, manipulationssicher</dd>
            </div>
          </dl>
        </div>
        <RekordKarte
          kopf="req_5d94e120 · vollständig"
          felder={[
            { schluessel: 'anfrage_id', wert: 'req_5d94e120' },
            { schluessel: 'modell', wert: 'nachweis-llm-70b' },
            { schluessel: 'subprozessor', wert: 'Keiner — DataFortress.cloud GmbH', ton: 'gut' },
            { schluessel: 'rechenzentrum', wert: 'Frankfurt, DE · eigenes RZ' },
            { schluessel: 'retention', wert: 'kein Training · 0 Tage' },
            { schluessel: 'tokens_in / out', wert: '890 / 143' },
            { schluessel: 'hash', wert: 'c91a3e6f204b8d71…' },
            { schluessel: 'vorgänger_hash', wert: '7be1c4a9f3d820e6…' },
          ]}
          fuss="Exportierbar als Art. 30 VVT-Eintrag, signiertes PDF oder CSV."
        />
      </div>

      <p class="mt-16 marginalie mb-3">Was Sie damit exportieren</p>
      <h3 class="display display-m text-blau max-w-2xl">Vier Dokumente, die Sie mit einem Klick bekommen.</h3>
      <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-linie border border-linie">
        {exporte.map((e) => (
          <div class="bg-bogen-rein p-6">
            <p class="font-display font-bold text-blau" style="font-variation-settings: 'wdth' 90;">{e.titel}</p>
            <p class="mt-2 text-sm text-blau-soft leading-relaxed">{e.beschreibung}</p>
          </div>
        ))}
      </div>

      <!-- Handlungspfad mitten im langen Erklärteil, nicht erst nach dem Scrollen. -->
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href="/?tarif=compliance#zugang" class="knopf knopf-siegel" data-tarif-cta="nachweis-inline">Zugang anfragen</a>
        <Kontingent variante="zeile" />
      </div>
    </div>
  </section>

  <!-- 5. Playground -->
  <section id="playground" class="py-16 sm:py-20 border-b border-linie">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between gap-4 flex-wrap mb-8">
        <div>
          <p class="marginalie mb-3">Playground</p>
          <h2 class="display display-l text-blau">Probieren Sie den Ernstfall aus.</h2>
        </div>
        <a href="/playground" class="text-sm font-semibold text-siegel hover:underline">Playground in voller Größe →</a>
      </div>
      <Playground compact />
    </div>
  </section>

  <!-- 6. Die drei Säulen -->
  <section id="saeulen" class="py-16 sm:py-20 border-b border-linie bg-bogen-tief">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="marginalie mb-3">Die drei Säulen</p>
      <h2 class="display display-l text-blau max-w-2xl">Nicht nur, welcher EU-Anbieter — sondern ob es überhaupt einen gibt.</h2>
      <p class="mt-4 text-blau-soft max-w-2xl leading-relaxed">
        Säule 2 und 3 lösen die Subprozessor-Frage nicht durch eine bessere Wahl, sondern indem es keinen externen Subprozessor mehr gibt.
      </p>
      <div class="mt-10 grid md:grid-cols-3 gap-px bg-linie border border-linie">
        {SAEULEN.map((s) => (
          <div
            class:list={[
              'bg-bogen-rein p-6 flex flex-col',
              s.akzent === 'gold' && 'border-t-[3px] border-gold',
            ]}
          >
            <span class={`marke ${s.akzent === 'blau' ? 'marke-neutral' : s.akzent === 'siegel' ? 'marke-siegel' : 'marke-gold'} w-fit`}>
              {s.kurzname} · {s.kosten}
            </span>
            <p class="mt-3 font-display font-bold text-blau leading-snug" style="font-variation-settings: 'wdth' 90;">{s.name}</p>
            <p class="mt-2 text-sm text-blau-soft leading-relaxed flex-1">{s.beschreibung}</p>
            <p class="mt-4 text-xs text-blau-faint leading-relaxed">{s.eignung}</p>
            <div class="mt-4 pt-4 border-t border-linie space-y-1 font-mono text-xs text-blau-faint">
              <p>Subprozessor: {s.subprozessor}</p>
              <p>Rechenzentrum: {s.rechenzentrum}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="mt-8 border border-sperr bg-sperr-blass px-6 py-5 max-w-3xl">
        <p class="marke marke-sperr mb-3">Fail closed</p>
        <p class="text-sm text-blau leading-relaxed">
          Für Säule 1 gilt: kein Fallback außerhalb der EU-Routingliste. Ist kein EU-Modell verfügbar, schlägt die Anfrage fehl — sie wird nicht umgeleitet. Für Säule 2/3 stellt sich die Frage erst gar nicht — sehen Sie sich das im <a href="/playground" class="underline hover:no-underline">Playground</a> an.
        </p>
      </div>
    </div>
  </section>

  <!-- 7. Belege — sozialer Nachweis zwischen Lösung und Angebot. -->
  <section id="belege" class="py-16 sm:py-20 border-b border-linie">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="marginalie mb-3">Stimmen</p>
      <h2 class="display display-l text-blau max-w-2xl">Wie andere die Freigabe bekommen haben.</h2>
      <div class="mt-10">
        <Belege />
      </div>
    </div>
  </section>

  <!-- 8. Für wen -->
  <section id="fuer-wen" class="py-16 sm:py-20 border-b border-linie bg-bogen-tief">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="marginalie mb-3">Für wen</p>
      <h2 class="display display-l text-blau max-w-2xl">§ 203 Abs. 1 StGB nennt Sie namentlich.</h2>
      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-linie border border-linie">
        {['Steuerberater · Wirtschaftsprüfer', 'Rechtsanwälte · Notare', 'Ärzte · Zahnärzte', 'Psychotherapeuten', 'Ambulante Pflegedienste', 'Sonstige Berufsgeheimnisträger'].map((b) => (
          <div class="bg-bogen-rein p-6 text-sm font-semibold text-blau">{b}</div>
        ))}
      </div>
      <div class="mt-10 grid md:grid-cols-3 gap-6">
        {szenarien.map((s) => (
          <div class="border-l-2 border-siegel pl-4">
            <p class="font-display font-bold text-blau" style="font-variation-settings: 'wdth' 90;">{s.beruf}</p>
            <p class="mt-1.5 text-sm text-blau-soft leading-relaxed">{s.problem}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. Integrationen — inkl. Sidecar, damit vor dem Angebot ein Abschnitt weniger steht. -->
  <section id="integrationen" class="py-16 sm:py-20 border-b border-linie">
