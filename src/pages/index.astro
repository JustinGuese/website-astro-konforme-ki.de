---
import Site from '../layouts/Site.astro';
import Kette from '../components/Kette.astro';
import HeroBlock from '@justinguese/astro-kit/HeroBlock.astro';
import RekordKarte from '../components/RekordKarte.astro';
import Playground from '../components/Playground.astro';
import LeiterTabelle from '../components/LeiterTabelle.astro';
import Belege from '../components/Belege.astro';
import ScarcityBlock from '@justinguese/astro-kit/ScarcityBlock.astro';
import InfografikForm from '../components/InfografikForm.astro';
import ZugangForm from '../components/ZugangForm.astro';
import ConversionTracking from '@justinguese/astro-kit/ConversionTracking.astro';
import FaqBlock from '@justinguese/astro-kit/FaqBlock.astro';
import CtaBand from '@justinguese/astro-kit/CtaBand.astro';
import SectionHeader from '@justinguese/astro-kit/SectionHeader.astro';
import { buildChain } from '../lib/kette';
import { LEITER } from '../lib/preise';
import { KONTINGENT, frei } from '../lib/kontingent';
import { site } from '../config/site';

/**
 * Reihenfolge folgt der Trichterlogik, nicht der Produktlogik — überarbeitet
 * 2026-08-24: Sidecar (Prüfspur über bestehende Cloud) ist jetzt das
 * Hauptangebot, nicht mehr ein Abschnitt für „Vorsichtige". Vollständig
 * gehostete Inferenz (Angebote/Zugang) ist der Eskalationspfad, nicht der
 * Einstieg — siehe MARKETING.md „Infra & architecture critique". Zielgruppe
 * ist breit (jedes Unternehmen mit DSB oder Betriebsrat), § 203 StGB bleibt
 * eine bediente, benannte Nische statt der gesamten Ansprache — siehe
 * MARKETING.md „One vertical, not three".
 */
const abschnitte = [
  { id: 'hero', label: 'Einstieg' },
  { id: 'problem', label: 'Das Problem' },
  { id: 'sidecar', label: 'Sidecar' },
  { id: 'playground', label: 'Playground' },
  { id: 'nachweis', label: 'Der Nachweis' },
  { id: 'unterlagen', label: 'Unterlagen' },
  { id: 'checkliste', label: 'Checkliste' },
  { id: 'integrationen', label: 'Integrationen' },
  { id: 'angebote', label: 'Angebote' },
  { id: 'zugang', label: 'Zugang' },
  { id: 'faq', label: 'FAQ' },
  { id: 'abschluss', label: 'Abschluss' },
];
const gliedes = buildChain('index', abschnitte);

const exporte = [
  { titel: 'Art. 30 VVT-Eintrag', beschreibung: 'Automatisch generierter Eintrag in Ihr Verarbeitungsverzeichnis, pro Anfrage aktualisiert.' },
  { titel: 'AI-Act Art. 12 Logging', beschreibung: 'Protokollierungsformat, vorbereitet auf die Nachweispflichten des AI Act.' },
  { titel: 'Subprozessorenliste', beschreibung: 'Mit Änderungshistorie — jede Änderung eines Subprozessors wird dokumentiert und gemeldet.' },
  { titel: 'Signierter Export', beschreibung: 'Ein Klick: CSV und PDF, kryptografisch signiert, bereit für Ihren Prüfer.' },
];

/**
 * Für #angebote: Leiter ohne die €39-Dossier-Stufe (die bleibt als SKU voll
 * erreichbar — Ratgeber-Upsell, direkter Link — nur nicht mehr auf der
 * Startseite gezeigt), Compliance hervorgehoben. Kopie, nie die geteilten
 * LEITER-Objekte mutieren — ArtikelUpsell.astro liest dieselben Objekte
 * positionsbasiert (LEITER.slice(0,2)).
 */
const angeboteLeiter = LEITER.filter((s) => s.tarifId !== 'dossier').map((s) =>
  s.tarifId === 'compliance' ? { ...s, hervorgehoben: true } : s
);

const faq = [
  {
    frage: 'Kann ich mit meiner bestehenden Cloud starten?',
    antwort: 'Ja, genau das ist der Sidecar-Ansatz: Nachweis läuft neben Ihrer bestehenden Azure-OpenAI-, Bedrock- oder Cloud-Inferenz und übernimmt nur die Prüfspur — Sie ändern nichts an Ihrer Infrastruktur. Reicht Ihre eigene Cloud für einen Fall nicht aus (z. B. kein passendes EU-Modell, ein besonders sensibles Mandat), hosten wir die Inferenz stattdessen vollständig — siehe „Angebote".',
  },
  {
    frage: 'Was hat der Betriebsrat damit zu tun?',
    antwort: 'Wenn Ihr Unternehmen einen Betriebsrat hat und die KI Verhalten oder Leistung von Mitarbeitenden erfassen kann, greift die Mitbestimmung nach § 87 Abs. 1 Nr. 6 BetrVG. Die Prüfspur beantwortet dieselbe Frage wie für Ihren Datenschutzbeauftragten: wer hat wann worauf zugegriffen, mit welchem Modell, bei welchem Anbieter.',
  },
  {
    frage: 'Was, wenn unser bisheriger Anbieter in den USA sitzt?',
    antwort: 'Dann unterliegt er dem US CLOUD Act — US-Behörden können theoretisch Zugriff auf dort verarbeitete Daten verlangen, unabhängig vom Serverstandort. Unsere Routingliste für gehostete Inferenz ist ausschließlich EU-jurisdiktionell (Scaleway, IONOS, Mistral AI, OVHcloud), ohne Fallback außerhalb.',
  },
  {
    frage: 'Ist Nachweis selbst ein Berufsgeheimnisträger-konformer Subprozessor?',
    antwort: 'Wir sind Ihr Auftragsverarbeiter nach Art. 28 DSGVO und werden im Rahmen der Zusatzvereinbarung nach § 203 Abs. 3 StGB als mitwirkende Person eingebunden — vorausgesetzt, Sie schließen die entsprechende Vereinbarung mit uns ab. Ein Muster liegt unter „Unterlagen".',
  },
  {
    frage: 'Welche Modelle stehen zur Verfügung?',
    antwort: 'Im Standardfall laufen Ihre Anfragen auf eigener Infrastruktur der DataFortress.cloud GmbH in Nürnberg — ohne externen Subprozessor. Wer stattdessen das günstigere EU-Anbieter-Autorouting wählt (Säule 1), erhält ausschließlich Modelle, die über Scaleway, IONOS AI Model Hub, Mistral AI oder OVHcloud AI Endpoints in der EU gehostet werden. Die genaue Modellliste ist Teil Ihres Onboardings.',
  },
  {
    frage: 'Was passiert, wenn kein EU-Modell verfügbar ist?',
    antwort: 'Die Anfrage schlägt fehl — sie wird nicht außerhalb der EU-Routingliste umgeleitet. Sehen Sie sich das im Playground am Beispiel „Was passiert, wenn ich ein US-Modell anfordere?" an.',
  },
  {
    frage: 'Trainieren Sie auf unseren Daten?',
    antwort: 'Nein. Alle EU-Subprozessoren in unserer Routingliste sind vertraglich zu Zero-Retention bzw. Nicht-Training verpflichtet; das ist Teil unserer Auswahlkriterien.',
  },
  {
    frage: 'Warum sind die Zugangsschlüssel begrenzt?',
    antwort: 'Weil wir jeden Start persönlich begleiten und die §203-Zusatzvereinbarung individuell gegenzeichnen. Das skaliert nicht beliebig, deshalb vergeben wir pro Monat ein festes Kontingent. Ist es ausgeschöpft, rücken Sie auf den Folgemonat.',
  },
  {
    frage: 'Ist der Token-Einstieg wirklich kostenlos?',
    antwort: 'Ja, bis 5 Mio. Token ohne Zahlungsmittel. Danach informieren wir Sie, bevor Kosten entstehen.',
  },
  {
    frage: 'Was kostet ein Machbarkeits-Check?',
    antwort: 'Zwischen €1.900 und €9.000 einmalig, abhängig von Umfang und Anzahl der zu integrierenden Kanäle. Details unter „Angebote".',
  },
  {
    frage: 'Ist Nachweis Rechtsberatung?',
    antwort: 'Nein. Nachweis ersetzt nicht die Prüfung durch Ihre eigene Rechtsberatung im Einzelfall.',
  },
  {
    frage: 'Ist der Gateway ein Medizinprodukt?',
    antwort: 'Nein — er verarbeitet, aber bewertet nicht, und ist damit kein Medizinprodukt im Sinne der MDR.',
  },
  {
    frage: 'Übernimmt Nachweis meine Haftung?',
    antwort: 'Nein. Ihre Berufspflichten bleiben bei Ihnen. Wir liefern die Infrastruktur und den Nachweis dazu.',
  },
  {
    frage: 'Ersetzt der AVV meine Mandantenvereinbarung?',
    antwort: 'Nein — unser AVV ergänzt, ersetzt aber nicht Ihre eigene Mandantenvereinbarung zur KI-Nutzung.',
  },
];
---

<Site>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify([
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      url: site.url,
      name: site.name,
      inLanguage: 'de-DE',
      publisher: { '@type': 'Organization', name: site.name },
    },
  ])} />

  <Kette gliedes={gliedes} slot="kette" />

  <!-- 1. Hero — Sidecar ist das Hauptangebot; gehostete Inferenz ist der Eskalationspfad. -->
  <section id="hero" class="py-14 sm:py-20 border-b border-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <HeroBlock
        eyebrow="Für Ihre bestehende KI — Azure OpenAI, Bedrock oder eigene Cloud"
        sub="Nachweis läuft als Sidecar neben Ihrer bestehenden KI — Sie ändern nichts an Ihrer Infrastruktur, wir liefern die exportierbare Prüfspur. Reicht Ihre eigene Cloud für einen Fall nicht aus, hosten wir ihn."
        cta={{ label: 'Sidecar einrichten', href: '/kontakt?interesse=sidecar', track: 'sidecar' }}
        bullets={['Kein US-Fallback', 'Kein Training auf Ihren Daten', 'AVV inklusive']}
      >
        <Fragment slot="headline">Der Betriebsrat blockt. Der DSB blockt. <span class="text-accent">Wir liefern beiden den Nachweis.</span></Fragment>

        <div slot="cta-secondary" class="mt-3 flex flex-col gap-2 items-start">
          <ScarcityBlock
            class="kontingent-akzent"
            total={KONTINGENT.plaetze}
            taken={KONTINGENT.vergeben}
            layout="badge"
            badgeText="Noch {left} von {total} Zugangsschlüsseln diesen Monat frei"
          />
          <a href="/?tarif=compliance#zugang" class="font-mono text-xs text-ink-faint hover:text-accent underline underline-offset-2" data-cta="hero-hosted-alt">
            Lieber direkt gehostete Inferenz? Zugangsschlüssel sichern →
          </a>
          <a href="/playground" class="font-mono text-xs text-ink-faint hover:text-accent underline underline-offset-2" data-cta="playground-hero">
            Playground öffnen →
          </a>
        </div>

        <RekordKarte
          kopf="req_8f2a1c93"
          felder={[
            { schluessel: 'modell', wert: 'nachweis-llm-70b' },
            { schluessel: 'subprozessor', wert: 'Keiner — DataFortress.cloud GmbH', ton: 'ok' },
            { schluessel: 'rechenzentrum', wert: 'Nürnberg, DE · eigenes RZ' },
            { schluessel: 'retention', wert: 'kein Training · 0 Tage' },
            { schluessel: 'tokens_in / out', wert: '412 / 96' },
            { schluessel: 'hash', wert: '7be1c4a9f3d820e6…' },
          ]}
          fuss="Jede Anfrage hinterlässt eine Prüfspur — nicht nur Ihre Rechnung."
        />
      </HeroBlock>
    </div>
  </section>

  <!-- 2. Problem — breite Blocker, nicht mehr §203-exklusiv. -->
  <section id="problem" class="py-16 sm:py-20 border-b border-line bg-canvas-deep">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader eyebrow="Das Problem" title={'Drei Gründe, warum „einfach ChatGPT nehmen" keine Option ist.'} size="lg" />
      <div class="mt-10 grid md:grid-cols-3 gap-px bg-line border border-line">
        <div class="bg-surface p-6">
          <p class="font-mono text-xs text-signal font-semibold">Art. 28 DSGVO</p>
          <p class="mt-2 font-display font-bold text-ink" style="font-variation-settings: 'wdth' 90;">Kein unterschreibbarer AVV</p>
          <p class="mt-2 text-sm text-ink-soft leading-relaxed">Mit einem US-Anbieter, dessen Verarbeitung Sie nicht auditierbar nachweisen können, lässt sich kein belastbarer Auftragsverarbeitungsvertrag schließen.</p>
        </div>
        <div class="bg-surface p-6">
          <p class="font-mono text-xs text-signal font-semibold">US CLOUD Act · GeschGehG</p>
          <p class="mt-2 font-display font-bold text-ink" style="font-variation-settings: 'wdth' 90;">Fremdes Zugriffsrecht</p>
          <p class="mt-2 text-sm text-ink-soft leading-relaxed">Ein US-Anbieter unterliegt dem US CLOUD Act — US-Behörden können Zugriff verlangen, unabhängig vom Serverstandort. Für Geschäftsgeheimnisse nach dem GeschGehG löst eine EU-AVV allein das nicht.</p>
        </div>
        <div class="bg-surface p-6">
          <p class="font-mono text-xs text-signal font-semibold">§ 87 Abs. 1 Nr. 6 BetrVG</p>
          <p class="mt-2 font-display font-bold text-ink" style="font-variation-settings: 'wdth' 90;">Der Betriebsrat redet mit</p>
          <p class="mt-2 text-sm text-ink-soft leading-relaxed">KI-Systeme, die Verhalten oder Leistung von Mitarbeitenden erfassen können, unterliegen der Mitbestimmung. Ohne Betriebsvereinbarung steht ein Rollout auf wackligen Beinen — unabhängig davon, ob die Technik selbst compliant ist.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Sidecar — das Hauptangebot: Prüfspur über die KI, die Sie schon haben. -->
  <section id="sidecar" class="py-16 sm:py-20 border-b border-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        eyebrow="Das Angebot"
        title="Ihre KI, unsere Prüfspur."
        lead="Sie müssen Ihre bestehende KI-Lösung nicht ersetzen, um zu starten. Nachweis läuft als Sidecar neben Ihrer aktuellen Inferenz — Azure OpenAI, AWS Bedrock oder eigene Cloud — und übernimmt ausschließlich die Prüfspur. Derselbe Nutzen, ohne Umstellungsrisiko und ohne eigene GPU-Kosten."
        size="lg"
      />
      <div class="mt-10 border border-line bg-surface p-8 sm:p-10 grid lg:grid-cols-[1.2fr_1fr] gap-8 items-center">
        <div>
          <SectionHeader
            as="h3"
            eyebrow="Wie es funktioniert"
            title="Sie ändern nichts an Ihrer Infrastruktur."
            lead="Der Sidecar beobachtet Ihre bestehenden Anfragen und schreibt dieselbe Prüfspur, die Sie im Playground sehen — Modell, Subprozessor, Hash, Zeitstempel. Reicht Ihre eigene Cloud für einen Fall nicht aus, etwa weil kein passendes EU-Modell verfügbar ist oder ein Mandat besonders sensibel ist, hosten wir die Inferenz stattdessen vollständig."
            size="md"
          />
        </div>
        <a href="/kontakt?interesse=sidecar" class="knopf knopf-accent w-full sm:w-fit sm:ml-auto" data-cta="sidecar">Sidecar einrichten</a>
      </div>
    </div>
  </section>

  <!-- 4. Playground -->
  <section id="playground" class="py-16 sm:py-20 border-b border-line bg-canvas-deep">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between gap-4 flex-wrap mb-8">
        <SectionHeader eyebrow="Playground" title="Probieren Sie den Ernstfall aus." size="lg" />
        <a href="/playground" class="text-sm font-semibold text-accent hover:underline">Playground in voller Größe →</a>
      </div>
      <Playground compact />
    </div>
  </section>

  <!-- 5. Der Nachweis — die größte Fläche der Seite, inkl. Exportformate. -->
  <section id="nachweis" class="py-16 sm:py-24 border-b border-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="marginalie mb-3">Der Nachweis</p>
          <h2 class="display display-l text-ink">Nicht die Tokens sind das Produkt. <span class="text-accent">Diese Zeile ist es.</span></h2>
          <p class="mt-5 text-ink-soft leading-relaxed max-w-lg">
            Jede EU-Inferenzplattform verkauft Ihnen Tokens und einen PDF-AVV. Keine gibt Ihrem Datenschutzbeauftragten oder Prüfer eine per Anfrage exportierbare Beweiskette. Das ist der Unterschied zwischen „wir sind konform" und „hier ist der Beweis".
          </p>
          <dl class="mt-8 space-y-4 text-sm">
            <div class="flex gap-3">
              <dt class="font-mono text-ink-faint w-32 shrink-0">modell</dt>
              <dd class="text-ink-soft">welches Modell tatsächlich geantwortet hat</dd>
            </div>
            <div class="flex gap-3">
              <dt class="font-mono text-ink-faint w-32 shrink-0">subprozessor</dt>
              <dd class="text-ink-soft">wer die Anfrage verarbeitet hat, namentlich</dd>
            </div>
            <div class="flex gap-3">
              <dt class="font-mono text-ink-faint w-32 shrink-0">hash</dt>
              <dd class="text-ink-soft">verkettet mit der vorherigen Anfrage, manipulationssicher</dd>
            </div>
            <div class="flex gap-3">
              <dt class="font-mono text-ink-faint w-32 shrink-0">ablageort</dt>
              <dd class="text-ink-soft">Prüfspur liegt immer auf eigener DataFortress-Infrastruktur in Nürnberg — ob Sidecar über Ihre Cloud oder vollständig gehostet</dd>
            </div>
          </dl>
        </div>
        <RekordKarte
          kopf="req_5d94e120 · vollständig"
          felder={[
            { schluessel: 'anfrage_id', wert: 'req_5d94e120' },
            { schluessel: 'modell', wert: 'nachweis-llm-70b' },
            { schluessel: 'subprozessor', wert: 'Keiner — DataFortress.cloud GmbH', ton: 'ok' },
            { schluessel: 'rechenzentrum', wert: 'Nürnberg, DE · eigenes RZ' },
            { schluessel: 'retention', wert: 'kein Training · 0 Tage' },
            { schluessel: 'tokens_in / out', wert: '890 / 143' },
            { schluessel: 'hash', wert: 'c91a3e6f204b8d71…' },
            { schluessel: 'vorgänger_hash', wert: '7be1c4a9f3d820e6…' },
          ]}
          fuss="Exportierbar als Art. 30 VVT-Eintrag, signiertes PDF oder CSV."
        />
      </div>

      <p class="mt-16 marginalie mb-3">Was Sie damit exportieren</p>
      <h3 class="display display-m text-ink max-w-2xl">Vier Dokumente, die Sie mit einem Klick bekommen.</h3>
      <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-line border border-line">
        {exporte.map((e) => (
          <div class="bg-surface p-6">
            <p class="font-display font-bold text-ink" style="font-variation-settings: 'wdth' 90;">{e.titel}</p>
            <p class="mt-2 text-sm text-ink-soft leading-relaxed">{e.beschreibung}</p>
          </div>
        ))}
      </div>

      <!-- Handlungspfad mitten im langen Erklärteil, nicht erst nach dem Scrollen. -->
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href="/?tarif=compliance#zugang" class="knopf knopf-accent" data-cta="nachweis-inline">Zugangsschlüssel sichern</a>
        <a href="/eu-inferenz" class="knopf knopf-linie" data-cta="nachweis-eu-inferenz">EU-Inferenz ansehen</a>
        <ScarcityBlock
          class="kontingent-akzent"
          total={KONTINGENT.plaetze}
          taken={KONTINGENT.vergeben}
          layout="badge"
          badgeText="Noch {left} von {total} Zugangsschlüsseln diesen Monat frei"
        />
      </div>
    </div>
  </section>

  <!-- 6. Unterlagen + Belege, zusammengeführt — Dokumenten-Vertrauen statt Kundenzitate. -->
  <section id="unterlagen" class="py-16 sm:py-20 border-b border-line bg-canvas-deep">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <SectionHeader
          eyebrow="Unterlagen"
          title="Laden Sie herunter, was Ihr Datenschutzbeauftragter braucht — ohne sich anzumelden."
          lead="AVV, TOM, Subprozessorenliste, §203-Zusatzvereinbarung und ein VVT-Muster. Kein Formular, keine E-Mail-Pflicht."
          size="lg"
          align="center"
        />
        <a href="/unterlagen" class="knopf knopf-linie mt-7">Unterlagen ansehen</a>
      </div>

      <div class="mt-14">
        <SectionHeader as="h3" eyebrow="Fakten statt Zitate" title="Wir zitieren keine Kunden, die wir noch nicht haben. Das hier stimmt trotzdem." size="md" />
        <div class="mt-8">
          <Belege />
        </div>
      </div>

      <p class="mt-8 text-sm text-ink-faint max-w-2xl">
        Zusätzlich Berufsgeheimnisträger — Kanzlei, Praxis, Steuerberatung? Die §203-Zusatzvereinbarung oben ist genau dafür.
      </p>
    </div>
  </section>

  <!--
    7. Checkliste — die kostenlose Stufe der Angebotsleiter. Einziges Feld: E-Mail.
  -->
  <section id="checkliste" class="py-16 sm:py-20 border-b border-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-[1fr_1.1fr] gap-10 lg:gap-16 items-center">
        <div>
          <div class="flex items-center gap-3 flex-wrap">
            <p class="marginalie">Stufe 01 · kostenlos</p>
            <span class="marke marke-accent">PDF, eine Seite</span>
          </div>
          <h2 class="mt-3 display display-l text-ink">Bevor Sie irgendetwas kaufen: <span class="text-accent">prüfen Sie, ob es bei Ihnen überhaupt zulässig ist.</span></h2>
          <p class="mt-5 text-ink-soft leading-relaxed max-w-lg">
            Die 12 Punkte, die Ihr Datenschutzbeauftragter durchgeht, bevor er KI freigibt — AI Act, DSGVO und § 203 StGB auf einer Seite, in der Reihenfolge, in der sie tatsächlich anfallen. Zum Weiterleiten gedacht.
          </p>
          <ul class="mt-6 space-y-2.5">
            {['Keine Registrierung, nur E-Mail', 'Direkt an Ihren DSB weiterleitbar', 'Gilt auch, wenn Sie sich gegen uns entscheiden'].map((punkt) => (
              <li class="flex items-start gap-2.5 text-sm text-ink-soft">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-accent"></span>
                {punkt}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <InfografikForm
            id="checkliste"
            quelle="startseite"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Integrationen — Kanäle für den gehosteten Pfad; der Sidecar-Pitch steht bereits oben. -->
  <section id="integrationen" class="py-16 sm:py-20 border-b border-line bg-canvas-deep">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between gap-4 flex-wrap">
        <SectionHeader eyebrow="Integrationen" title="Wenn Sie doch gehostete Inferenz wollen: da, wo Sie ohnehin schon arbeiten." size="lg" />
        <a href="/integrationen" class="text-sm font-semibold text-accent hover:underline">Alle Kanäle ansehen →</a>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        {['Microsoft Teams', 'Slack', 'WhatsApp Business', 'E-Mail', 'Webhook / REST', 'OpenAI-kompatibles SDK'].map((k) => (
          <span class="marke marke-neutral !text-sm !py-1.5 !px-3">{k}</span>
        ))}
      </div>
    </div>
  </section>

  <!--
    9. Angebote — der gehostete Pfad, ausdrücklich als Eskalation zum Sidecar
    gerahmt, nicht als Haupteinstieg. Ersetzt die frühere Token-Preistabelle
    an dieser Stelle: hier fällt die Kaufentscheidung, Abrechnungsdetails
    stehen auf /preise.
  -->
  <section id="angebote" class="py-16 sm:py-24 border-b border-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        eyebrow="Angebote"
        title="Wenn Sie lieber vollständig gehostete Inferenz wollen."
        lead="Statt eines Sidecars über Ihre bestehende Cloud: drei Stufen, Sie steigen ein, wo Sie stehen. Ein individueller Machbarkeits-Check kostet €1.900–9.000 einmalig — die laufende Prüfspur für €290 im Monat ist der günstigere, sofort startbare Weg dorthin."
        size="lg"
      />

      <div class="mt-10">
        <LeiterTabelle stufen={angeboteLeiter} />
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border border-line bg-surface px-6 py-4">
        <p class="text-sm text-ink-soft">
          Tokens werden separat abgerechnet — Pay-per-Token ab €3,50/Mio. oder als Abo mit inkludiertem Kontingent.
        </p>
        <a href="/preise" class="text-sm font-semibold text-accent hover:underline whitespace-nowrap">Alle Abrechnungsmodelle →</a>
      </div>
    </div>
  </section>

  <!-- 10. Zugang — der Eskalationspfad zur gehosteten Inferenz. -->
  <section id="zugang" class="py-16 sm:py-20 border-b border-line bg-canvas-deep">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        eyebrow="Zugang"
        title="Zugangsschlüssel sichern."
        lead="Keine Kreditkarte, kein Verkaufsgespräch. Wir vergeben Zugangsschlüssel aktuell manuell."
        size="lg"
        align="center"
      />
      <ScarcityBlock
        class="mt-8 kontingent-akzent"
        total={KONTINGENT.plaetze}
        taken={KONTINGENT.vergeben}
        layout="band"
        badgeText="Noch {left} von {total} Zugangsschlüsseln diesen Monat frei"
        bandTitle="Zugangsschlüssel frei diesen Monat"
        bandBody={`Wir vergeben Zugangsschlüssel manuell und begleiten jeden Start persönlich — deshalb pro Monat begrenzt. ${KONTINGENT.vergeben} von ${KONTINGENT.plaetze} bereits vergeben.`}
      />
      <div class="mt-4">
        <ZugangForm />
      </div>
    </div>
  </section>

  <!-- 11. FAQ -->
  <section id="faq" class="py-16 sm:py-20 border-b border-line">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader eyebrow="FAQ" title="Häufige Fragen." size="lg" class="mb-10" />
      <FaqBlock items={faq.map((f) => ({ q: f.frage, a: f.antwort }))} openIndex={-1} />
    </div>
  </section>

  <!-- 12. Abschluss — die Seite endet auf einer Handlung, nicht auf einer Frage. -->
  <CtaBand
    id="abschluss"
    title="Ihr Datenschutzbeauftragter wartet auf einen Beleg. Holen Sie ihn sich."
    body="Sidecar über Ihre bestehende KI oder direkt gehostete Inferenz — beides ohne Zahlungsmittel und ohne Verkaufsgespräch."
    cta={{ label: 'Sidecar einrichten', href: '/kontakt?interesse=sidecar', track: 'abschluss-sidecar' }}
    secondary={{ label: 'Direkt gehostete Inferenz', href: '/?tarif=compliance#zugang', track: 'abschluss-zugang' }}
  >
    <span slot="eyebrow" class="marke marke-dunkel">Noch {frei} Plätze diesen Monat</span>
    <svg slot="cta-icon" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
  </CtaBand>

  <ConversionTracking states={[
    { flag: 'zugang_gesendet', revealId: 'zugang-gesendet', event: 'zugang', label: 'Zugang Waitlist' },
    { flag: 'infografik_gesendet', revealId: 'checkliste-gesendet', event: 'infografik', label: 'EU-KI-Recht Checkliste' },
  ]} />
</Site>
