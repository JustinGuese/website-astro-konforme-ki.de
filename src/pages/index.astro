---
import Site from '../layouts/Site.astro';
import Kette from '../components/Kette.astro';
import RekordKarte from '../components/RekordKarte.astro';
import Playground from '../components/Playground.astro';
import LeiterTabelle from '../components/LeiterTabelle.astro';
import Belege from '../components/Belege.astro';
import ScarcityBlock from '@justinguese/astro-kit/ScarcityBlock.astro';
import InfografikForm from '../components/InfografikForm.astro';
import ZugangForm from '../components/ZugangForm.astro';
import ConversionTracking from '@justinguese/astro-kit/ConversionTracking.astro';
import FaqBlock from '@justinguese/astro-kit/FaqBlock.astro';
import CtaBand from '@justinguese/astro-kit/CtaBand.astro';
import SectionHeader from '@justinguese/astro-kit/SectionHeader.astro';
import { buildChain } from '../lib/kette';
import { KONTINGENT, frei } from '../lib/kontingent';
import { findProdukt } from '../lib/produkte';
import { site, apiUrl } from '../config/site';

/**
 * Positionierung seit 2026-09-15: die Startseite spricht Berufsgeheimnisträger
 * an (§ 203 StGB), nicht mehr jedes Unternehmen mit DSB oder Betriebsrat.
 * Begründung in MARKETING.md („Repositionierung 2026-09-15"): gegen IONOS,
 * STACKIT & Co. mit C5-Testat ist ein Ein-GPU-Anbieter im breiten Markt
 * chancenlos; bei der §203-Verschwiegenheitsvereinbarung für Deutschland-
 * Inferenz nicht. Router und Sidecar bleiben vollwertige Produkte, stehen
 * aber hinter dem Zugang in #weitere-wege statt gleichrangig im Hero.
 *
 * Harte Regel für jede Zeile hier: keine Alleinstellungsbehauptung. Große
 * Anbieter bieten inzwischen eigene §203-Vereinbarungen an — die Seite sagt
 * das selbst und argumentiert mit dem, was bei uns anders ist.
 */
const abschnitte = [
  { id: 'hero', label: 'Schweigepflicht' },
  { id: 'problem', label: 'Das Problem' },
  { id: 'unterschrift', label: 'Wer unterschreibt' },
  { id: 'nachweis', label: 'Der Nachweis' },
  { id: 'playground', label: 'Playground' },
  { id: 'unterlagen', label: 'Unterlagen' },
  { id: 'grenzen', label: 'Wann nicht' },
  { id: 'checkliste', label: 'Checkliste' },
  { id: 'leiter', label: 'Einstieg wählen' },
  { id: 'zugang', label: 'Zugang' },
  { id: 'weitere-wege', label: 'Ohne § 203' },
  { id: 'faq', label: 'FAQ' },
  { id: 'abschluss', label: 'Abschluss' },
];
const gliedes = buildChain('index', abschnitte);

const testHref = '/kontakt?interesse=de-inferenz-test';
const vereinbarungHref = '/unterlagen/203-zusatzvereinbarung';

/** Was ein AVV allein nicht leistet. Allgemeine Rechtslage, nie „gilt für Sie" (RDG). */
const problem = [
  {
    norm: '§ 203 Abs. 4 StGB',
    titel: 'Die Verpflichtung ist Ihre Pflicht',
    text: 'Wer Berufsgeheimnisse an einen Dienstleister weitergibt, muss dafür sorgen, dass dieser zur Geheimhaltung verpflichtet wurde. Ein Auftragsverarbeitungsvertrag nach Art. 28 DSGVO allein leistet das nicht.',
  },
  {
    norm: '§ 43e BRAO · § 62a StBerG',
    titel: 'Textform und Belehrung',
    text: 'Das Berufsrecht verlangt einen Vertrag in Textform, der den Dienstleister zur Verschwiegenheit verpflichtet, über die strafrechtlichen Folgen belehrt und regelt, wen er seinerseits einbinden darf.',
  },
  {
    norm: '§ 203 Abs. 4 S. 2 Nr. 2 StGB',
    titel: 'Jede weitere Stelle zählt',
    text: 'Bindet Ihr Dienstleister weitere Stellen ein — Modellanbieter, Rechenzentren, Weiterleitungen —, muss auch jede davon verpflichtet sein. Je länger die Kette, desto schwerer lässt sie sich belegen.',
  },
];

const unterschied = [
  {
    titel: 'Keine US-Muttergesellschaft',
    text: 'Auch große US-Anbieter bieten inzwischen Zusatzvereinbarungen für Berufsgeheimnisträger an. Sie bleiben aber Unternehmen, von denen US-Behörden nach dem CLOUD Act Daten verlangen können. DataFortress.cloud GmbH ist eine deutsche GmbH ohne ausländische Muttergesellschaft.',
  },
  {
    titel: 'Wer unterschreibt, betreibt die Server',
    text: 'Die Vereinbarung zeichnet die Geschäftsführung, die die Server selbst betreibt — mit persönlicher Verpflichtungserklärung jeder Person, die Zugriff hat, namentlich in der Anlage genannt.',
  },
  {
    titel: 'Kein fremder Modellanbieter',
    text: 'Das Modell läuft auf unseren Servern, nicht bei einem Drittanbieter hinter einer Schnittstelle. Jede weitere beteiligte Stelle steht namentlich in der Subprozessorenliste — vor dem Vertrag einsehbar.',
  },
];

/** Ehrliche Ausschlusskriterien — lieber hier als im Audit. */
const grenzen = [
  {
    fall: 'Sie brauchen ein BSI-C5-Testat des Anbieters',
    antwort: 'Das haben wir nicht. Große deutsche Cloud-Anbieter haben es — wenn Ihre Beschaffung darauf besteht, sind Sie dort besser aufgehoben.',
  },
  {
    fall: 'Sie sind Bank, Versicherer oder Finanzdienstleister',
    antwort: 'Die DORA-Anforderungen an IKT-Drittdienstleister — Prüfrechte, Ausstiegsplan, Redundanz — können wir heute nicht belastbar erfüllen.',
  },
  {
    fall: 'Sie brauchen garantierte Verfügbarkeit',
    antwort: 'Aktuell eine Region, eine GPU. Fällt sie aus, schlägt die Anfrage fehl, statt umgeleitet zu werden — gewollt, aber kein Hochverfügbarkeits-Versprechen.',
  },
  {
    fall: 'Sie brauchen das stärkste Modell am Markt',
    antwort: 'Qwen3.8-27B reicht für Zusammenfassen, Extrahieren und Entwürfe von Fachtexten. Bei komplexen Agenten- oder Coding-Aufgaben liegt es hinter großen proprietären Modellen.',
  },
];

const router = findProdukt('router');
const sidecar = findProdukt('sidecar');

const wechsel = `- base_url="https://api.openai.com/v1"
+ base_url="${apiUrl('/v1')}"`;

const faq = [
  {
    frage: 'Wofür gilt die §203-Zusatzvereinbarung?',
    antwort: 'Ausschließlich für Deutschland-Inferenz — Anfragen, die auf unseren eigenen Servern verarbeitet werden. Bei Router und Sidecar sind Modellanbieter bzw. Ihre eigene Cloud beteiligt, die wir nicht zur Verschwiegenheit verpflichten können. Dort bieten wir sie deshalb nicht an.',
  },
  {
    frage: 'Bieten große Anbieter so eine Vereinbarung nicht auch an?',
    antwort: 'Teilweise ja. Vergleichen Sie drei Dinge: wer unterschreibt, welchem Recht der Anbieter und seine Muttergesellschaft unterliegen, und wie viele weitere Stellen an der Verarbeitung beteiligt sind. Brauchen Sie ein Zertifikat wie BSI C5, ist ein großer Anbieter die bessere Wahl.',
  },
  {
    frage: 'Was steht in der Vereinbarung?',
    antwort: 'Verpflichtung zur Verschwiegenheit in Textform, Belehrung über die strafrechtlichen Folgen, Kenntnisnahme nur soweit erforderlich, Regeln für weitere mitwirkende Personen, keine Verarbeitung im Ausland und die namentliche Liste der Personen mit Zugriff. Das Muster liegt ohne Anmeldung unter „Unterlagen".',
  },
  {
    frage: 'Werden unsere Anfragen gespeichert oder zum Training genutzt?',
    antwort: 'Bei Deutschland-Inferenz nein: gespeichert werden Token-Anzahl, Zeitstempel und Anfrage-ID — nicht Prompt oder Antwort. Kein Training auf Ihren Daten.',
  },
  {
    frage: 'Welches Modell steht zur Verfügung?',
    antwort: 'Deutschland-Inferenz liefert Qwen3.8-27B (FP8) unter Apache-2.0-Lizenz, 131.072 Token Kontext. Router und Sidecar bieten je nach Schutzstufe eine größere Auswahl — ohne §203-Zusatzvereinbarung.',
  },
  {
    frage: 'Ist der Token-Einstieg wirklich kostenlos?',
    antwort: 'Ja, bis 5 Mio. Token pro Monat ohne Zahlungsmittel. Beim Erreichen des Kontingents wird gedrosselt, nicht automatisch abgerechnet.',
  },
  {
    frage: 'Warum sind die Zugangsschlüssel begrenzt?',
    antwort: 'Weil wir jeden Start persönlich begleiten und die §203-Zusatzvereinbarung individuell gegenzeichnen. Das skaliert nicht beliebig, deshalb vergeben wir pro Monat ein festes Kontingent.',
  },
  {
    frage: 'Was kostet ein Machbarkeits-Check?',
    antwort: 'Zwischen €1.900 und €9.000 einmalig, abhängig von Umfang und Anzahl der zu integrierenden Kanäle. Details unter „Einstieg wählen".',
  },
  {
    frage: 'Ist konforme-ki.de Rechtsberatung?',
    antwort: 'Nein. Weder das Angebot noch die Vereinbarungsmuster ersetzen die Prüfung durch Ihre Kammer oder Rechtsberatung im Einzelfall.',
  },
  {
    frage: 'Ist der Dienst ein Medizinprodukt?',
    antwort: 'Nein — er verarbeitet, aber bewertet nicht, und ist damit kein Medizinprodukt im Sinne der MDR.',
  },
  {
    frage: 'Übernehmen Sie meine Haftung?',
    antwort: 'Nein. Ihre Berufspflichten bleiben bei Ihnen. Wir liefern die Verpflichtung, die Infrastruktur und den Nachweis dazu.',
  },
  {
    frage: 'Ersetzt der AVV meine Mandantenvereinbarung?',
    antwort: 'Nein — AVV und Zusatzvereinbarung ergänzen, ersetzen aber nicht Ihre eigene Vereinbarung mit Mandanten oder Patienten zur KI-Nutzung.',
  },
];
---

<Site>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify([
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      url: site.url,
      name: site.name,
      inLanguage: 'de-DE',
      publisher: { '@type': 'Organization', name: site.name },
    },
  ])} />

  <Kette gliedes={gliedes} slot="kette" />

  <!--
    1. Hero — Zielgruppe, Versprechen und Beleg im ersten Viewport. Rechts steht
    kein Code mehr (der spricht Entwickler an, nicht die Kanzlei), sondern die
    Antwort auf die Frage, die eine Kammer stellt: wer kann mitlesen?
  -->
  <section id="hero" class="py-14 sm:py-20 border-b border-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-[1.15fr_1fr] gap-10 lg:gap-14 items-start">
        <div>
          <p class="marginalie mb-3">Für Kanzleien, Steuerberatung und Praxen</p>
          <h1 class="display display-xl text-ink">
            KI mit <span class="text-accent">unterschriebener Schweigepflicht</span> nach § 203 StGB.
          </h1>
          <p class="mt-5 text-ink-soft leading-relaxed max-w-2xl">
            Für Mandanten- und Patientendaten: ein Sprachmodell auf Servern in Deutschland, betrieben von einer deutschen GmbH ohne US-Muttergesellschaft. Wer die Verschwiegenheitsvereinbarung unterschreibt, betreibt die Server selbst — und zu jeder Anfrage entsteht ein Protokoll, das Sie Ihrer Kammer, Ihrem Mandanten oder Ihrem Datenschutzbeauftragten vorlegen können.
          </p>

          <div class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-3">
            <a href={testHref} class="knopf knopf-accent" data-cta="hero-test">
              Kostenlos testen
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
            </a>
            <a href={vereinbarungHref} class="knopf knopf-linie" data-cta="hero-vereinbarung">Vereinbarung lesen</a>
          </div>
          <p class="mt-3 font-mono text-xs text-ink-faint">
            5 Mio. Token pro Monat · ohne Zahlungsmittel · Vereinbarung ohne Anmeldung einsehbar
          </p>
          <ScarcityBlock
            class="mt-4 kontingent-akzent"
            total={KONTINGENT.plaetze}
            taken={KONTINGENT.vergeben}
            layout="badge"
            badgeText="Noch {left} von {total} Zugangsschlüsseln diesen Monat frei"
          />
        </div>

        <RekordKarte
          kopf="mitwirkende Personen · Deutschland-Inferenz"
          felder={[
            { schluessel: 'vertragspartner', wert: 'DataFortress.cloud GmbH, Deutschland' },
            { schluessel: 'muttergesellschaft', wert: 'keine', ton: 'ok' },
            { schluessel: 'verpflichtung', wert: '§ 203 StGB · Textform · mit Belehrung', ton: 'ok' },
            { schluessel: 'unterzeichnet_von', wert: 'Geschäftsführung, die die Server betreibt' },
            { schluessel: 'modellanbieter', wert: 'keiner — Modell auf eigenen Servern', ton: 'ok' },
            { schluessel: 'weitere_stellen', wert: 'namentlich in der Subprozessorenliste' },
            { schluessel: 'prompt_speicherung', wert: '0 Tage · kein Training' },
          ]}
          fuss="Muster der Vereinbarung und Subprozessorenliste liegen offen unter „Unterlagen“."
        />
      </div>
    </div>
  </section>

  <!-- 2. Problem — was ein AVV nicht leistet. Allgemeine Rechtslage, keine Einzelfallbewertung. -->
  <section id="problem" class="py-16 sm:py-20 border-b border-line bg-canvas-deep">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader eyebrow="Das Problem" title="Für Berufsgeheimnisse reicht ein AVV nicht." size="lg" />
      <div class="mt-10 grid md:grid-cols-3 gap-px bg-line border border-line">
        {problem.map((p) => (
          <div class="bg-surface p-6">
            <p class="font-mono text-xs text-signal font-semibold">{p.norm}</p>
            <p class="mt-2 font-display font-bold text-ink" style="font-variation-settings: 'wdth' 90;">{p.titel}</p>
            <p class="mt-2 text-sm text-ink-soft leading-relaxed">{p.text}</p>
          </div>
        ))}
      </div>
      <p class="mt-5 text-xs text-ink-faint max-w-2xl">
        Allgemeine Information, keine Rechtsberatung. Ob und wie diese Vorschriften auf Sie anwendbar sind, klären Sie mit Ihrer Kammer oder Rechtsberatung.
      </p>
    </div>
  </section>

  <!-- 3. Wer unterschreibt — der Unterschied, ohne Alleinstellung zu behaupten. -->
  <section id="unterschrift" class="py-16 sm:py-20 border-b border-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        eyebrow="Wer unterschreibt"
        title="Eine Vereinbarung ist so viel wert wie das, was hinter der Unterschrift steht."
        lead="Verschwiegenheitsvereinbarungen bieten inzwischen mehrere Anbieter an. Vergleichen Sie, wer unterschreibt, welchem Recht er unterliegt und wie viele Stellen mitlesen könnten."
        size="lg"
      />
      <div class="mt-10 grid md:grid-cols-3 gap-px bg-line border border-line">
        {unterschied.map((u) => (
          <div class="bg-surface p-6">
            <p class="font-display font-bold text-ink" style="font-variation-settings: 'wdth' 90;">{u.titel}</p>
            <p class="mt-2 text-sm text-ink-soft leading-relaxed">{u.text}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href={vereinbarungHref} class="knopf knopf-linie" data-cta="unterschrift-vereinbarung">Vereinbarung lesen</a>
        <a href="/unterlagen/subprozessoren" class="text-sm font-semibold text-accent hover:underline">Subprozessorenliste ansehen →</a>
      </div>
    </div>
  </section>

  <!-- 4. Der Nachweis — die Vereinbarung sagt, was gelten soll; das Protokoll, was passiert ist. -->
  <section id="nachweis" class="py-16 sm:py-24 border-b border-line bg-canvas-deep">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="marginalie mb-3">Der Nachweis</p>
          <h2 class="display display-l text-ink">Die Vereinbarung sagt, was gelten soll. <span class="text-accent">Diese Zeile zeigt, was passiert ist.</span></h2>
          <p class="mt-5 text-ink-soft leading-relaxed max-w-lg">
            Zu jeder Anfrage entsteht ein Eintrag: welches Modell geantwortet hat, wo es lief, dass nichts gespeichert wurde — verkettet mit dem vorherigen Eintrag, damit sich nachträglich nichts unbemerkt ändern lässt. Exportierbar für Kammer, Mandant oder Datenschutzbeauftragten.
          </p>
          <dl class="mt-8 space-y-4 text-sm">
            <div class="flex gap-3">
              <dt class="font-mono text-ink-faint w-32 shrink-0">modell</dt>
              <dd class="text-ink-soft">welches Modell tatsächlich geantwortet hat</dd>
            </div>
            <div class="flex gap-3">
              <dt class="font-mono text-ink-faint w-32 shrink-0">rechenzentrum</dt>
              <dd class="text-ink-soft">wo die Anfrage verarbeitet wurde, mit dem Betreiber namentlich</dd>
            </div>
            <div class="flex gap-3">
              <dt class="font-mono text-ink-faint w-32 shrink-0">retention</dt>
              <dd class="text-ink-soft">dass Prompt und Antwort nicht gespeichert wurden</dd>
            </div>
            <div class="flex gap-3">
              <dt class="font-mono text-ink-faint w-32 shrink-0">hash</dt>
              <dd class="text-ink-soft">verkettet mit der vorherigen Anfrage, manipulationssicher</dd>
            </div>
          </dl>
        </div>
        <RekordKarte
          kopf="req_5d94e120 · vollständig"
          felder={[
            { schluessel: 'anfrage_id', wert: 'req_5d94e120' },
            { schluessel: 'modell', wert: 'qwen3.8-27b' },
            { schluessel: 'betreiber', wert: 'DataFortress.cloud GmbH', ton: 'ok' },
            { schluessel: 'rechenzentrum', wert: 'Nürnberg, DE · Hetzner Online GmbH' },
            { schluessel: 'retention', wert: 'kein Training · 0 Tage' },
            { schluessel: 'tokens_in / out', wert: '890 / 143' },
            { schluessel: 'hash', wert: 'c91a3e6f204b8d71…' },
            { schluessel: 'vorgänger_hash', wert: '7be1c4a9f3d820e6…' },
          ]}
          fuss="Exportierbar als Art. 30 VVT-Eintrag, signiertes PDF oder CSV."
        />
      </div>
    </div>
  </section>

  <!-- 5. Playground -->
  <section id="playground" class="py-16 sm:py-20 border-b border-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between gap-4 flex-wrap mb-8">
        <SectionHeader eyebrow="Playground" title="Sehen Sie, was zu einem Mandantenschreiben protokolliert wird." size="lg" />
        <a href="/playground" class="text-sm font-semibold text-accent hover:underline">Playground in voller Größe →</a>
      </div>
      <Playground compact />
    </div>
  </section>

  <!-- 6. Unterlagen + Belege -->
  <section id="unterlagen" class="py-16 sm:py-20 border-b border-line bg-canvas-deep">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <SectionHeader
          eyebrow="Unterlagen"
          title="Lesen Sie die Vereinbarung, bevor Sie mit uns sprechen."
          lead="§203-Zusatzvereinbarung, AVV, TOM, Subprozessorenliste und VVT-Muster. Kein Formular, keine E-Mail-Pflicht."
          size="lg"
          align="center"
        />
        <div class="mt-7 flex flex-wrap justify-center gap-4">
          <a href={vereinbarungHref} class="knopf knopf-accent" data-cta="unterlagen-vereinbarung">§203-Zusatzvereinbarung</a>
          <a href="/unterlagen" class="knopf knopf-linie">Alle Unterlagen</a>
        </div>
      </div>

      <div class="mt-14">
        <SectionHeader as="h3" eyebrow="Fakten statt Zitate" title="Wir zitieren keine Kunden, die wir noch nicht haben. Das hier stimmt trotzdem." size="md" />
        <div class="mt-8">
          <Belege />
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Grenzen — wer hier falsch ist. Vertrauen entsteht auch durch Absagen. -->
  <section id="grenzen" class="py-16 sm:py-20 border-b border-line">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        eyebrow="Wann wir nicht passen"
        title="Lieber hier als im Audit: wann Sie einen anderen Anbieter nehmen sollten."
        size="lg"
        class="mb-8"
      />
      <div class="grid sm:grid-cols-2 gap-px bg-line border border-line">
        {grenzen.map((g) => (
          <div class="bg-surface p-6">
            <p class="font-display font-bold text-ink" style="font-variation-settings: 'wdth' 90;">{g.fall}</p>
            <p class="mt-2 text-sm text-ink-soft leading-relaxed">{g.antwort}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Checkliste — die kostenlose Stufe der Angebotsleiter. Einziges Feld: E-Mail. -->
  <section id="checkliste" class="py-16 sm:py-20 border-b border-line bg-canvas-deep">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-[1fr_1.1fr] gap-10 lg:gap-16 items-center">
        <div>
          <div class="flex items-center gap-3 flex-wrap">
            <p class="marginalie">Stufe 01 · kostenlos</p>
            <span class="marke marke-accent">PDF, eine Seite</span>
          </div>
          <h2 class="mt-3 display display-l text-ink">Bevor Sie irgendetwas kaufen: <span class="text-accent">prüfen Sie, ob es bei Ihnen überhaupt zulässig ist.</span></h2>
          <p class="mt-5 text-ink-soft leading-relaxed max-w-lg">
            Die 12 Punkte, die vor dem KI-Einsatz in Kanzlei oder Praxis geklärt sein sollten — § 203 StGB, DSGVO und AI Act auf einer Seite, in der Reihenfolge, in der sie tatsächlich anfallen.
          </p>
          <ul class="mt-6 space-y-2.5">
            {['Keine Registrierung, nur E-Mail', 'Direkt an Ihren DSB weiterleitbar', 'Gilt auch, wenn Sie sich gegen uns entscheiden'].map((punkt) => (
              <li class="flex items-start gap-2.5 text-sm text-ink-soft">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-accent"></span>
                {punkt}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <InfografikForm id="checkliste" quelle="startseite" />
        </div>
      </div>
    </div>
  </section>

  <!-- 9. Einstieg wählen — volle Leiter inkl. §203-Dossier: für diese Zielgruppe der natürliche Zwischenschritt. -->
  <section id="leiter" class="py-16 sm:py-24 border-b border-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        eyebrow="Einstieg wählen"
        title="Wie Sie starten."
        lead="Kostenlose Checkliste, das §203-Dossier zum Festpreis oder die laufende Prüfspur im Abo — Sie steigen ein, wo Sie stehen."
        size="lg"
      />
      <div class="mt-10">
        <LeiterTabelle />
      </div>
      <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border border-line bg-surface px-6 py-4">
        <p class="text-sm text-ink-soft">
          Deutschland-Inferenz: 5 Mio. Token/Monat kostenlos, im Compliance-Tarif 25 Mio. Token inklusive.
        </p>
        <a href="/deutschland-inferenz" class="text-sm font-semibold text-accent hover:underline whitespace-nowrap">Tarife und Modell →</a>
      </div>
    </div>
  </section>

  <!-- 10. Zugang -->
  <section id="zugang" class="py-16 sm:py-20 border-b border-line bg-canvas-deep">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        eyebrow="Zugang"
        title="Zugangsschlüssel sichern."
        lead="Keine Kreditkarte, kein Verkaufsgespräch. Wir vergeben Zugangsschlüssel aktuell manuell."
        size="lg"
        align="center"
      />
      <ScarcityBlock
        class="mt-8 kontingent-akzent"
        total={KONTINGENT.plaetze}
        taken={KONTINGENT.vergeben}
        layout="band"
        badgeText="Noch {left} von {total} Zugangsschlüsseln diesen Monat frei"
        bandTitle="Zugangsschlüssel frei diesen Monat"
        bandBody={`Wir vergeben Zugangsschlüssel manuell und zeichnen jede §203-Zusatzvereinbarung persönlich gegen — deshalb pro Monat begrenzt. ${KONTINGENT.vergeben} von ${KONTINGENT.plaetze} bereits vergeben.`}
      />
      <div class="mt-4">
        <ZugangForm />
      </div>
    </div>
  </section>

  <!--
    11. Weitere Wege — Router und Sidecar für alle ohne § 203. Steht nach dem
    Zugang, damit die Hauptzielgruppe nicht vor dem Formular abbiegt; der
    base_url-Wechsel bleibt als Argument für Entwickler erhalten.
  -->
  <section id="weitere-wege" class="py-16 sm:py-20 border-b border-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        eyebrow="Ohne § 203"
        title="Kein Berufsgeheimnisträger? Dann gibt es zwei weitere Wege."
        lead="Für Unternehmen und Entwicklerteams, die mehr Modellauswahl brauchen oder ihre bestehende Cloud behalten wollen — mit derselben Prüfspur, aber ohne §203-Zusatzvereinbarung, weil dort Anbieter beteiligt sind, die wir nicht verpflichten können."
        size="lg"
      />
      <div class="mt-10 grid grid-cols-1 lg:grid-cols-[1fr_1fr_1.1fr] gap-px bg-line border border-line">
        {[router, sidecar].map((p) => (
          <div class="bg-surface p-6 flex flex-col min-w-0">
            <p class="font-mono text-[11px] uppercase tracking-[.16em] text-ink-faint">{p.eyebrow}</p>
            <p class="mt-2 font-display font-bold text-ink text-xl" style="font-variation-settings: 'wdth' 90;">{p.name}</p>
            <p class="mt-2 text-sm text-ink-soft leading-relaxed flex-grow">{p.einzeiler}</p>
            <p class="mt-4 font-mono text-sm font-semibold text-ink">{p.kosten}</p>
            <a href={p.href} class="mt-3 text-sm font-semibold text-accent hover:underline" data-cta={`weitere-wege-${p.produktId}`}>{p.name} ansehen →</a>
          </div>
        ))}
        <div class="bg-ink-deep p-6 flex flex-col min-w-0">
          <p class="font-mono text-[11px] uppercase tracking-[.16em] text-ink-faint">Der ganze Wechsel</p>
          <pre class="mt-3 text-sm font-mono text-[#dbe2ef] overflow-x-auto leading-relaxed"><code>{wechsel}</code></pre>
          <p class="mt-3 text-sm text-[#dbe2ef]/80 leading-relaxed flex-grow">Requests, Responses und Streaming bleiben identisch — für jedes OpenAI-SDK, Cursor, Claude Code und Copilot.</p>
          <a href="/einstufung" class="mt-4 text-sm font-semibold text-accent-bright hover:underline" data-cta="weitere-wege-einstufung">Welcher Weg passt? Vier Fragen →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 12. FAQ -->
  <section id="faq" class="py-16 sm:py-20 border-b border-line bg-canvas-deep">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader eyebrow="FAQ" title="Häufige Fragen." size="lg" class="mb-10" />
      <FaqBlock items={faq.map((f) => ({ q: f.frage, a: f.antwort }))} openIndex={-1} />
    </div>
  </section>

  <!-- 13. Abschluss — die Seite endet auf einer Handlung, nicht auf einer Frage. -->
  <CtaBand
    id="abschluss"
    title="Ihre Schweigepflicht endet nicht beim Dienstleister. Unsere auch nicht."
    body="Lesen Sie die Vereinbarung, testen Sie mit 5 Mio. Token ohne Zahlungsmittel — und entscheiden Sie dann."
    cta={{ label: 'Kostenlos testen', href: testHref, track: 'abschluss-test' }}
    secondary={{ label: 'Vereinbarung lesen', href: vereinbarungHref, track: 'abschluss-vereinbarung' }}
  >
    <span slot="eyebrow" class="marke marke-dunkel">Noch {frei} Plätze diesen Monat</span>
    <svg slot="cta-icon" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
  </CtaBand>

  <ConversionTracking states={[
    { flag: 'zugang_gesendet', revealId: 'zugang-gesendet', event: 'zugang', label: 'Zugang Waitlist' },
    {
      flag: 'infografik_gesendet',
      revealId: 'checkliste-gesendet',
      event: 'infografik',
      label: 'EU-KI-Recht Checkliste',
      // Ein Freebie ist keine Kaufabsicht. Ohne eigenes Event optimiert Meta
      // die Anzeigenauslieferung sonst auf Gratis-Downloader statt auf Leads.
      metaEvent: 'FreeDownload',
      metaCustom: true,
    },
  ]} />
</Site>
