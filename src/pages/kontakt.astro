---
import Site from '../layouts/Site.astro';
import FormBlock from '@justinguese/astro-kit/FormBlock.astro';
import ConversionTracking from '@justinguese/astro-kit/ConversionTracking.astro';
import SectionHeader from '@justinguese/astro-kit/SectionHeader.astro';
import { site } from '../config/site';

const title = 'Kontakt | Nachweis';
const description = 'Fragen zum Onboarding, zum Sidecar-Einsatz oder zum Compliance-Tarif? Schreiben Sie uns.';
---
<Site title={title} description={description}>
  <section class="bg-canvas-deep border-b border-line">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12 text-center">
      <SectionHeader
        as="h1"
        eyebrow="Kontakt"
        title="Lassen Sie uns reden."
        lead="Fragen zum Onboarding, zum Sidecar-Einsatz oder zum Compliance-Tarif? Schreiben Sie uns — wir antworten in der Regel innerhalb eines Werktages."
        size="lg"
        align="center"
      />
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <div id="sent-banner" class="hidden mb-6 p-4 border border-accent bg-accent-pale text-ink text-sm">
        <span class="marke marke-accent mb-2">Angekommen</span>
        <p class="mt-2">Danke! Ihre Nachricht ist angekommen — wir melden uns in Kürze.</p>
      </div>

      <FormBlock
        formspreeId={site.formspreeId!}
        variant="allgemein"
        name="kontakt"
        success={{ flag: 'kontakt_gesendet' }}
        submitLabel="Nachricht senden"
        class="kontakt-form bg-surface border border-line p-6 sm:p-8 space-y-5"
      >
        <input type="hidden" id="interesse-field" name="interesse" value="allgemein" />

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="name" class="block font-mono text-xs uppercase tracking-wider text-ink-faint mb-1.5">Name</label>
            <input
              id="name" name="name" type="text" required autocomplete="name"
              class="w-full border border-line bg-canvas px-4 py-3 text-base text-ink placeholder-ink-faint focus:outline-none focus:border-accent"
              placeholder="Ihr Name"
            />
          </div>
          <div>
            <label for="firma" class="block font-mono text-xs uppercase tracking-wider text-ink-faint mb-1.5">Kanzlei / Praxis</label>
            <input
              id="firma" name="firma" type="text" required autocomplete="organization"
              class="w-full border border-line bg-canvas px-4 py-3 text-base text-ink placeholder-ink-faint focus:outline-none focus:border-accent"
              placeholder="Name Ihrer Kanzlei / Praxis"
            />
          </div>
        </div>

        <div>
          <label for="email" class="block font-mono text-xs uppercase tracking-wider text-ink-faint mb-1.5">E-Mail</label>
          <input
            id="email" name="email" type="email" required autocomplete="email"
            class="w-full border border-line bg-canvas px-4 py-3 text-base text-ink placeholder-ink-faint focus:outline-none focus:border-accent"
            placeholder="sie@kanzlei.de"
          />
        </div>

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="berufsgruppe" class="block font-mono text-xs uppercase tracking-wider text-ink-faint mb-1.5">Berufsgruppe</label>
            <select id="berufsgruppe" name="berufsgruppe" class="w-full border border-line bg-canvas px-4 py-3 text-base text-ink focus:outline-none focus:border-accent">
              <option value="">Bitte wählen</option>
              <option value="steuerberatung">Steuerberatung</option>
              <option value="rechtsanwaltschaft">Rechtsanwaltschaft</option>
              <option value="arztpraxis">Arzt- / Zahnarztpraxis</option>
              <option value="notariat">Notariat</option>
              <option value="psychotherapie">Psychotherapie</option>
              <option value="pflegedienst">Pflegedienst</option>
              <option value="sonstige">Sonstige Berufsgeheimnisträger</option>
            </select>
          </div>
          <div>
            <label for="phone" class="block font-mono text-xs uppercase tracking-wider text-ink-faint mb-1.5">
              Telefon <span class="normal-case font-sans text-ink-faint/80">(optional)</span>
            </label>
            <input
              id="phone" name="phone" type="tel" autocomplete="tel"
              class="w-full border border-line bg-canvas px-4 py-3 text-base text-ink placeholder-ink-faint focus:outline-none focus:border-accent"
              placeholder="+49 …"
            />
          </div>
        </div>

        <div>
          <label for="message" class="block font-mono text-xs uppercase tracking-wider text-ink-faint mb-1.5">Nachricht</label>
          <textarea
            id="message" name="message" required rows="6"
            class="w-full border border-line bg-canvas px-4 py-3 text-base text-ink placeholder-ink-faint focus:outline-none focus:border-accent"
            placeholder="Worum geht es?"
          ></textarea>
        </div>

        <svg slot="submit-icon" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>

        <p slot="note" class="font-mono text-xs text-ink-faint text-center">
          Mit dem Absenden stimmen Sie unserer <a href="/datenschutz" class="underline hover:text-ink">Datenschutzerklärung</a> zu.
        </p>
      </FormBlock>
    </div>
  </section>

  <script is:inline>
    (() => {
      const params = new URLSearchParams(window.location.search);
      const interesse = params.get('interesse');

      const copy = {
        onboarding: 'Sie interessieren sich für den §203-/DSGVO-Machbarkeits-Check (€1.900–9.000) — senden Sie uns kurz Ihre Kontaktdaten, wir vereinbaren ein Erstgespräch.',
        sidecar: 'Sie möchten Nachweis als Sidecar neben Ihrer bestehenden KI-Lösung einsetzen — senden Sie uns kurz Ihre Kontaktdaten, wir klären die Details.',
        compliance: 'Sie interessieren sich für den Compliance-Tarif (€290/Monat) — senden Sie uns kurz Ihre Kontaktdaten.',
      };

      if (interesse && copy[interesse]) {
        // SectionHeader's lead paragraph has no id hook — this page has
        // exactly one SectionHeader, so the class is unambiguous.
        const preHeader = document.querySelector('.df-head__lead');
        if (preHeader) preHeader.textContent = copy[interesse];
        const interesseField = document.getElementById('interesse-field');
        if (interesseField) interesseField.value = interesse;
        // FormBlock's _next field has no id — select it by attribute instead.
        const nextField = document.querySelector('.kontakt-form input[name="_next"]');
        if (nextField) nextField.value = nextField.value + `&interesse=${interesse}`;
      }

      // Zeigt Erfolg/versteckt Formular; Analytics und URL-Aufräumen
      // übernimmt ConversionTracking unten (derselbe Flag-Name).
      if (params.get('kontakt_gesendet') === '1') {
        document.getElementById('sent-banner')?.classList.remove('hidden');
        document.querySelector('.kontakt-form')?.classList.add('hidden');
      }
    })();
  </script>

  <ConversionTracking states={[
    { flag: 'kontakt_gesendet', revealId: 'sent-banner', event: 'kontakt', label: 'Contact Form Submission' },
  ]} />
</Site>
