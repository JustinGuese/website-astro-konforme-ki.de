---
import Site from '../layouts/Site.astro';
import KanalKarte from '../components/KanalKarte.astro';
import WerkzeugTabs from '../components/WerkzeugTabs.astro';
import SectionHeader from '@justinguese/astro-kit/SectionHeader.astro';
import { SAEULEN, STANDARD_SAEULE, findSaeule } from '../lib/saeulen';
import { WERKZEUGE } from '../lib/werkzeuge';

const saeuleStandard = findSaeule(STANDARD_SAEULE);
const saeulenAndere = SAEULEN.filter((s) => s.id !== STANDARD_SAEULE);

const title = 'Integrationen | konforme-ki.de';
const description = 'konforme-ki.de als OpenAI-kompatibler Endpunkt — ein base_url-Wechsel genügt. Kanäle: Teams, Slack, WhatsApp, E-Mail, Webhook, SDK.';

const kanaele = [
  {
    name: 'OpenAI-kompatibles SDK',
    status: 'verfuegbar' as const,
    beschreibung: 'Ändern Sie in Ihrem bestehenden SDK nur die base_url — Requests, Responses und Streaming bleiben identisch.',
    rekordBeispiel: 'kanal=api, client_id=…',
  },
  {
    name: 'Webhook / REST',
    status: 'verfuegbar' as const,
    beschreibung: 'Direkter HTTPS-Endpunkt für eigene Automatisierungen, ohne SDK.',
    rekordBeispiel: 'kanal=webhook, quelle=…',
  },
  {
    name: 'Microsoft Teams',
    status: 'verfuegbar' as const,
    beschreibung: 'Ein Bot in Ihrem Teams-Mandanten, jede Konversation mit vollständiger Prüfspur.',
    rekordBeispiel: 'kanal=teams, mandant_id=…',
  },
  {
    name: 'Slack',
    status: 'verfuegbar' as const,
    beschreibung: 'App für Ihren Workspace, protokolliert pro Kanal und Nutzer.',
    rekordBeispiel: 'kanal=slack, workspace_id=…',
  },
  {
    name: 'WhatsApp Business',
    status: 'verfuegbar' as const,
    beschreibung: 'Für Praxen und Kanzleien mit WhatsApp-Mandantenkontakt.',
    rekordBeispiel: 'kanal=whatsapp, nummer_hash=…',
  },
  {
    name: 'E-Mail (IMAP / Microsoft 365)',
    status: 'verfuegbar' as const,
    beschreibung: 'Verarbeitung eingehender E-Mails direkt aus Ihrem Postfach.',
    rekordBeispiel: 'kanal=email, postfach=…',
  },
  {
    name: 'Outlook Add-in',
    status: 'verfuegbar' as const,
    beschreibung: 'Die Prüfspur direkt im Outlook-Client, ohne Postfachzugriff von außen.',
    rekordBeispiel: 'kanal=outlook-addin, nutzer_id=…',
  },
  {
    name: 'DATEV-Export',
    status: 'verfuegbar' as const,
    beschreibung: 'Nachweis-Protokolle im DATEV-kompatiblen Format für Steuerberatungskanzleien.',
    rekordBeispiel: 'kanal=datev, mandant_nr=…',
  },
];

---

<Site title={title} description={description}>
  <section class="py-14 sm:py-20 border-b border-line">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="marginalie mb-3">Integrationen</p>
      <h1 class="display display-l text-ink max-w-2xl">Der Wechsel ist eine Zeile Code.</h1>
      <p class="mt-4 text-ink-soft max-w-2xl leading-relaxed">
        konforme-ki.de ist ein OpenAI-kompatibler Endpunkt. Alles, was heute gegen OpenAI oder Azure OpenAI spricht, spricht mit einer geänderten <code class="font-mono text-sm bg-canvas-deep px-1.5 py-0.5">base_url</code> stattdessen mit uns — inklusive Prüfspur.
      </p>
    </div>
  </section>

  <section class="py-12 border-b border-line bg-canvas-deep">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <WerkzeugTabs werkzeuge={WERKZEUGE} />
      <p class="mt-4 text-sm text-ink-faint leading-relaxed">
        Derselbe Hostname für jede Säule und jede Schutzstufe — nur Modellname bzw. Onboarding-Konfiguration ändern sich. Ihr Code bleibt sonst identisch. Wie die Säulen unten mit den vier Schutzstufen von <a href="/router" class="text-accent hover:underline">Router</a> zusammenhängen: Säule 2/3 (eigene DataFortress-Hardware) entspricht der höchsten Stufe, Säule 1 (EU-Anbieter-Autorouting) der EU-Stufe.
      </p>
    </div>
  </section>

  <!-- Säulen — von der Startseite hierher verschoben: Infrastruktur-Details gehören auf
       die technische Integrationsseite, nicht in den Homepage-Trichter. -->
  <section id="saeulen" class="py-16 sm:py-20 border-b border-line bg-canvas-deep">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        eyebrow="Die drei Säulen"
        title="Nicht nur, welcher EU-Anbieter — sondern ob es überhaupt einen gibt."
        lead="Säule 2 und 3 lösen die Subprozessor-Frage nicht durch eine bessere Wahl, sondern indem es keinen externen Subprozessor mehr gibt."
        size="md"
      />

      <div class="mt-10 border border-accent bg-surface p-7 sm:p-8 max-w-3xl">
        <span class="marke marke-accent w-fit">{saeuleStandard.kurzname} · {saeuleStandard.kosten} · Standard</span>
        <p class="mt-3 font-display font-bold text-ink text-lg leading-snug" style="font-variation-settings: 'wdth' 90;">{saeuleStandard.name}</p>
        <p class="mt-2 text-sm text-ink-soft leading-relaxed">{saeuleStandard.beschreibung}</p>
        <div class="mt-4 pt-4 border-t border-line flex flex-wrap gap-x-6 gap-y-1 font-mono text-xs text-ink-faint">
          <span>Subprozessor: {saeuleStandard.subprozessor}</span>
          <span>Rechenzentrum: {saeuleStandard.rechenzentrum}</span>
        </div>
      </div>

      <div class="mt-4 grid sm:grid-cols-2 gap-px bg-line border border-line max-w-3xl">
        {saeulenAndere.map((s) => (
          <div class:list={['bg-surface p-5', s.akzent === 'premium' && 'border-t-[3px] border-premium']}>
            <span class={`marke ${s.akzent === 'neutral' ? 'marke-neutral' : 'marke-premium'} w-fit`}>
              {s.kurzname} · {s.kosten}
            </span>
            <p class="mt-2 text-xs text-ink-soft leading-relaxed">{s.eignung}</p>
          </div>
        ))}
      </div>

      <div class="mt-8 border border-signal bg-signal-pale px-6 py-5 max-w-3xl">
        <p class="marke marke-signal mb-3">Fail closed</p>
        <p class="text-sm text-ink leading-relaxed">
          Für Säule 1 gilt: kein Fallback außerhalb der EU-Routingliste. Ist kein EU-Modell verfügbar, schlägt die Anfrage fehl — sie wird nicht umgeleitet. Für Säule 2/3 stellt sich die Frage erst gar nicht — sehen Sie sich das im <a href="/playground" class="underline hover:no-underline">Playground</a> an.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader eyebrow="Kanäle" title="Da, wo Sie ohnehin schon arbeiten." size="md" class="mb-8" />
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {kanaele.map((kanal) => <KanalKarte {...kanal} />)}
      </div>
      <p class="mt-8 text-sm text-ink-faint max-w-2xl">
        Kanäle mit dem Status „In Vorbereitung" oder „Auf Anfrage" sind noch nicht produktiv verfügbar. Interesse an einem bestimmten Kanal? <a href="/kontakt" class="text-accent hover:underline" data-contact-cta="integrationen">Schreiben Sie uns</a>.
      </p>
    </div>
  </section>
</Site>
