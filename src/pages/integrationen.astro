---
import Site from '../layouts/Site.astro';
import KanalKarte from '../components/KanalKarte.astro';
import CodeTabs from '../components/CodeTabs.astro';

const title = 'Integrationen | Nachweis';
const description = 'Nachweis als OpenAI-kompatibler Endpunkt — ein base_url-Wechsel genügt. Kanäle: Teams, Slack, WhatsApp, E-Mail, Webhook, SDK.';

const kanaele = [
  {
    name: 'OpenAI-kompatibles SDK',
    status: 'verfuegbar' as const,
    beschreibung: 'Ändern Sie in Ihrem bestehenden SDK nur die base_url — Requests, Responses und Streaming bleiben identisch.',
    rekordBeispiel: 'kanal=api, client_id=…',
  },
  {
    name: 'Webhook / REST',
    status: 'verfuegbar' as const,
    beschreibung: 'Direkter HTTPS-Endpunkt für eigene Automatisierungen, ohne SDK.',
    rekordBeispiel: 'kanal=webhook, quelle=…',
  },
  {
    name: 'Microsoft Teams',
    status: 'in-vorbereitung' as const,
    beschreibung: 'Ein Bot in Ihrem Teams-Mandanten, jede Konversation mit vollständiger Prüfspur.',
    rekordBeispiel: 'kanal=teams, mandant_id=…',
  },
  {
    name: 'Slack',
    status: 'in-vorbereitung' as const,
    beschreibung: 'App für Ihren Workspace, protokolliert pro Kanal und Nutzer.',
    rekordBeispiel: 'kanal=slack, workspace_id=…',
  },
  {
    name: 'WhatsApp Business',
    status: 'in-vorbereitung' as const,
    beschreibung: 'Für Praxen und Kanzleien mit WhatsApp-Mandantenkontakt.',
    rekordBeispiel: 'kanal=whatsapp, nummer_hash=…',
  },
  {
    name: 'E-Mail (IMAP / Microsoft 365)',
    status: 'in-vorbereitung' as const,
    beschreibung: 'Verarbeitung eingehender E-Mails direkt aus Ihrem Postfach.',
    rekordBeispiel: 'kanal=email, postfach=…',
  },
  {
    name: 'Outlook Add-in',
    status: 'auf-anfrage' as const,
    beschreibung: 'Nachweis direkt im Outlook-Client, ohne Postfachzugriff von außen.',
    rekordBeispiel: 'kanal=outlook-addin, nutzer_id=…',
  },
  {
    name: 'DATEV-Export',
    status: 'auf-anfrage' as const,
    beschreibung: 'Nachweis-Protokolle im DATEV-kompatiblen Format für Steuerberatungskanzleien.',
    rekordBeispiel: 'kanal=datev, mandant_nr=…',
  },
];

const codeTabs = [
  {
    label: 'Python',
    code: `from openai import OpenAI

client = OpenAI(
    base_url="https://gateway.konforme-ki.de/v1",
    api_key="ihr_schluessel",
)`,
  },
  {
    label: 'curl',
    code: `curl https://gateway.konforme-ki.de/v1/chat/completions \\
  -H "Authorization: Bearer ihr_schluessel" \\
  -H "Content-Type: application/json" \\
  -d '{"model":"mistral-large-2411","messages":[...]}'`,
  },
  {
    label: 'TypeScript',
    code: `import OpenAI from "openai";

const client = new OpenAI({
  baseURL: "https://gateway.konforme-ki.de/v1",
  apiKey: "ihr_schluessel",
});`,
  },
];
---

<Site title={title} description={description}>
  <section class="py-14 sm:py-20 border-b border-linie">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="marginalie mb-3">Integrationen</p>
      <h1 class="display display-l text-blau max-w-2xl">Der Wechsel ist eine Zeile Code.</h1>
      <p class="mt-4 text-blau-soft max-w-2xl leading-relaxed">
        Nachweis ist ein OpenAI-kompatibler Endpunkt. Alles, was heute gegen OpenAI oder Azure OpenAI spricht, spricht mit einer geänderten <code class="font-mono text-sm bg-bogen-tief px-1.5 py-0.5">base_url</code> stattdessen mit EU-Modellen — inklusive Prüfspur.
      </p>
    </div>
  </section>

  <section class="py-12 border-b border-linie bg-bogen-tief">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <CodeTabs tabs={codeTabs} />
      <p class="mt-4 text-sm text-blau-faint leading-relaxed">
        Das Beispiel oben nutzt Säule 1 (EU-Anbieter-Autorouting). Für Säule 2 oder 3 —
        Server der DataFortress.cloud GmbH, geteilt oder dediziert in Ihrem
        Rechenzentrum — ändert sich nur der Hostname:
        <code class="font-mono text-xs bg-bogen px-1.5 py-0.5">gateway.ai-nachweis.de</code>
        statt <code class="font-mono text-xs bg-bogen px-1.5 py-0.5">gateway.konforme-ki.de</code>.
        Ihr Code bleibt sonst identisch. Details zu allen drei Säulen: <a href="/#saeulen" class="text-siegel hover:underline">Startseite</a>.
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="marginalie mb-3">Kanäle</p>
      <h2 class="display display-m text-blau mb-8">Da, wo Sie ohnehin schon arbeiten.</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {kanaele.map((kanal) => <KanalKarte {...kanal} />)}
      </div>
      <p class="mt-8 text-sm text-blau-faint max-w-2xl">
        Kanäle mit dem Status „In Vorbereitung" oder „Auf Anfrage" sind noch nicht produktiv verfügbar. Interesse an einem bestimmten Kanal? <a href="/kontakt" class="text-siegel hover:underline">Schreiben Sie uns</a>.
      </p>
    </div>
  </section>
</Site>
