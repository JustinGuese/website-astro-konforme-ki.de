---
import { getCollection, render } from 'astro:content';
import Site from '../../layouts/Site.astro';

export async function getStaticPaths() {
  const dokumente = await getCollection('unterlagen');
  return dokumente.map((doc) => ({
    params: { slug: doc.id },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);
---

<Site title={`${doc.data.title} | Nachweis`} description={doc.data.kurz}>
  <div class="druck-kopf max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 text-xs text-blau-faint font-mono">
    konforme-ki.de/unterlagen/{doc.id} · {doc.data.version} · Stand: {doc.data.stand}
  </div>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="kein-druck flex items-center justify-between gap-4 flex-wrap mb-10 pb-6 border-b border-linie">
      <a href="/unterlagen" class="text-sm font-semibold text-siegel hover:underline">← Alle Unterlagen</a>
      <div class="flex items-center gap-3">
        <span class="font-mono text-xs text-blau-faint">{doc.data.version} · Stand: {doc.data.stand}</span>
        <button type="button" onclick="window.print()" class="knopf knopf-linie !py-2 !px-3.5 !text-xs">Drucken / Als PDF</button>
      </div>
    </div>

    <div class="article-body">
      <h1>{doc.data.title}</h1>
      <Content />
    </div>
  </div>
</Site>
