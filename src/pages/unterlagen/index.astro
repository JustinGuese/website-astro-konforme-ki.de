---
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';

const dokumente = (await getCollection('unterlagen')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);

const title = 'Unterlagen | Nachweis';
const description = 'AVV, TOM, Subprozessorenliste, §203-Zusatzvereinbarung und VVT-Muster — ungefiltert, ohne Formular.';
---

<Site title={title} description={description}>
  <section class="py-14 sm:py-20 border-b border-line">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="marginalie mb-3">Unterlagen</p>
      <h1 class="display display-l text-ink">Für Ihren Datenschutzbeauftragten — ohne Anmeldung.</h1>
      <p class="mt-4 text-ink-soft leading-relaxed">
        Diese fünf Dokumente reichen aus, um eine erste Einschätzung zu treffen, ob Nachweis für Ihre Kanzlei oder Praxis infrage kommt. Kein Formular, keine E-Mail-Pflicht — genau deshalb, weil das der Punkt ist: Ihr DSB soll das prüfen können, bevor irgendjemand mit Ihnen spricht.
      </p>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="divide-y divide-line border-t border-b border-line">
        {dokumente.map((doc) => (
          <a href={`/unterlagen/${doc.id}`} class="group flex items-start justify-between gap-4 py-6 hover:bg-canvas-deep -mx-4 px-4 transition-colors">
            <div>
              <p class="font-display font-bold text-ink group-hover:text-accent transition-colors" style="font-variation-settings: 'wdth' 90;">{doc.data.title}</p>
              <p class="mt-1.5 text-sm text-ink-soft leading-relaxed max-w-xl">{doc.data.kurz}</p>
              <p class="mt-2 font-mono text-xs text-ink-faint">{doc.data.version} · Stand: {doc.data.stand}</p>
            </div>
            <span class="shrink-0 text-accent text-xl leading-none mt-1">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Site>
