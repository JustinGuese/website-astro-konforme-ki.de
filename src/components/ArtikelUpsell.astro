---
import ScarcityBlock from '@justinguese/astro-kit/ScarcityBlock.astro';
import { LEITER } from '../lib/preise';
import { KONTINGENT } from '../lib/kontingent';

interface Props {
  /** Überschrift, die an das Artikelthema anschließt. */
  titel?: string;
  /** Ein Satz Brücke vom Artikel zum Angebot. */
  brueckentext?: string;
}

const {
  titel = 'Von der Rechtslage zur Freigabe.',
  brueckentext = 'Sie wissen jetzt, was gilt. Der schwierige Teil ist der Nachweis, dass Sie es einhalten — genau dafür gibt es Nachweis.',
} = Astro.props;

/** Nur die ersten beiden Stufen: kostenloser Einstieg und das €39-Dossier. */
const stufen = LEITER.slice(0, 2);
---

<aside class="kein-druck mt-16 border border-line bg-canvas-deep">
  <div class="px-6 sm:px-8 py-8">
    <p class="marginalie">Nächster Schritt</p>
    <h2 class="mt-3 display display-m text-ink !mt-3">{titel}</h2>
    <p class="mt-3 text-ink-soft leading-relaxed max-w-2xl">{brueckentext}</p>

    <div class="mt-7 grid sm:grid-cols-2 gap-px bg-line border border-line">
      {stufen.map((stufe) => (
        <div class="bg-surface p-5 flex flex-col">
          <div class="flex items-baseline justify-between gap-3">
            <p class="marginalie">Stufe {stufe.nummer}</p>
            <p class="font-mono text-sm font-semibold text-accent">{stufe.preis}</p>
          </div>
          <p class="mt-2.5 font-display font-bold text-ink text-sm" style="font-variation-settings: 'wdth' 90;">{stufe.name}</p>
          <p class="mt-2 text-sm text-ink-soft leading-relaxed flex-1">{stufe.beschreibung}</p>
          <a href={stufe.cta.href} class="knopf knopf-linie mt-5 w-full !py-2.5 !text-sm" data-cta={`ratgeber-${stufe.tarifId}`}>
            {stufe.cta.label}
          </a>
        </div>
      ))}
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
      <a href="/?tarif=compliance#zugang" class="knopf knopf-accent" data-cta="ratgeber-zugang">
        Zugangsschlüssel sichern
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
      </a>
      <ScarcityBlock
        class="kontingent-akzent"
        total={KONTINGENT.plaetze}
        taken={KONTINGENT.vergeben}
        layout="badge"
        badgeText="Noch {left} von {total} Zugangsschlüsseln diesen Monat frei"
      />
    </div>

    <p class="mt-5 pt-5 border-t border-line text-xs text-ink-faint leading-relaxed">
      Lieber erst selbst prüfen? <a href="/unterlagen" class="text-accent underline hover:no-underline">AVV, TOM und §203-Zusatzvereinbarung</a> liegen ohne Anmeldung offen, und im <a href="/playground" class="text-accent underline hover:no-underline">Playground</a> sehen Sie an einem aufgezeichneten Beispiel, wie eine Prüfspur konkret aussieht.
    </p>
  </div>
</aside>
