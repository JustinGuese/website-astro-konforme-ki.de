---
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_BLOCK_A_ID || 'REPLACE_WITH_FORMSPREE_ID';
const landingPage = Astro.url.pathname;
---
<form
  action={`https://formspree.io/f/${formspreeId}`}
  method="POST"
  class="bg-paper border-[1.5px] border-ink/80 p-6 sm:p-8 space-y-5"
>
  <input type="hidden" name="form" value="block_a" />
  <input type="hidden" name="landing_page" value={landingPage} />
  <input type="hidden" name="_next" value={`${landingPage}?starthilfe=1#starthilfe-download`} />
  <input type="text" name="_gotcha" style="display:none" />

  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <label for="firma" class="block font-mono text-xs uppercase tracking-wider text-ink-faint mb-1.5">Firma</label>
      <input
        id="firma" name="firma" type="text" required autocomplete="organization"
        class="w-full border-[1.5px] border-line bg-paper px-4 py-3 text-base text-ink placeholder-ink-faint focus:outline-none focus:border-ink"
        placeholder="Ambulanter Pflegedienst Muster GmbH"
      />
    </div>
    <div>
      <label for="email" class="block font-mono text-xs uppercase tracking-wider text-ink-faint mb-1.5">Geschäftliche E-Mail</label>
      <input
        id="email" name="email" type="email" required autocomplete="email"
        class="w-full border-[1.5px] border-line bg-paper px-4 py-3 text-base text-ink placeholder-ink-faint focus:outline-none focus:border-ink"
        placeholder="sie@ihr-pflegedienst.de"
      />
    </div>
  </div>

  <div>
    <label for="einrichtungsart" class="block font-mono text-xs uppercase tracking-wider text-ink-faint mb-1.5">Einrichtungsart</label>
    <select id="einrichtungsart" name="einrichtungsart" required
      class="w-full border-[1.5px] border-line bg-paper px-4 py-3 text-base text-ink focus:outline-none focus:border-ink">
      <option value="">Bitte wählen…</option>
      <option value="ambulanter_pflegedienst">Ambulanter Pflegedienst</option>
      <option value="stationaere_pflege">Stationäre Pflege</option>
      <option value="mvz">MVZ</option>
      <option value="arztpraxis">Arztpraxis</option>
      <option value="sonstige">Sonstige</option>
    </select>
  </div>

  <div>
    <label for="pruefanfragen" class="block font-mono text-xs uppercase tracking-wider text-ink-faint mb-1.5">Prüfanfragen pro Monat</label>
    <select id="pruefanfragen" name="pruefanfragen_pro_monat" required
      class="w-full border-[1.5px] border-line bg-paper px-4 py-3 text-base text-ink focus:outline-none focus:border-ink">
      <option value="">Bitte wählen…</option>
      <option value="0-5">0–5</option>
      <option value="6-20">6–20</option>
      <option value="ueber-20">Über 20</option>
    </select>
  </div>

  <div>
    <label for="beantwortet" class="block font-mono text-xs uppercase tracking-wider text-ink-faint mb-1.5">Wer beantwortet sie heute?</label>
    <select id="beantwortet" name="wer_beantwortet_heute" required
      class="w-full border-[1.5px] border-line bg-paper px-4 py-3 text-base text-ink focus:outline-none focus:border-ink">
      <option value="">Bitte wählen…</option>
      <option value="gf">Geschäftsführung</option>
      <option value="pdl">Pflegedienstleitung (PDL)</option>
      <option value="qmb">Qualitätsmanagement (QMB)</option>
      <option value="extern">Externe Beratung</option>
    </select>
  </div>

  <button
    type="submit"
    class="w-full inline-flex items-center justify-center gap-2 px-6 py-4 text-base font-semibold text-paper bg-stamp hover:bg-[color-mix(in_srgb,var(--color-stamp)_88%,black)] shadow-[4px_4px_0_0_var(--color-ink)] hover:shadow-[2px_2px_0_0_var(--color-ink)] hover:translate-x-[2px] hover:translate-y-[2px] transition-all"
  >
    Compliance-Paket kostenlos anfordern
    <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
  </button>

  <p class="font-mono text-xs text-ink-faint text-center">
    Kostenlos, kein Abo. Mit dem Absenden stimmen Sie unserer <a href="/datenschutz" class="underline hover:text-ink">Datenschutzerklärung</a> zu.
  </p>
</form>
