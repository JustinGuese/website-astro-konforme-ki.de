---
import { LEITER, ANKER } from '../lib/preise';
---

<div class="grid md:grid-cols-3 gap-px bg-linie border border-linie">
  {LEITER.map((stufe) => (
    <div class:list={['flex flex-col p-6 sm:p-7', stufe.hervorgehoben ? 'bg-blau-tief text-bogen' : 'bg-bogen-rein']}>
      <div class="flex items-center justify-between gap-3">
        <p class:list={['marginalie', stufe.hervorgehoben ? 'text-siegel-hell' : '']}>Stufe {stufe.nummer}</p>
        {stufe.hervorgehoben && <span class="marke marke-dunkel">Beliebtester Einstieg</span>}
      </div>

      <p class:list={['mt-4 font-display font-bold', stufe.hervorgehoben ? 'text-bogen' : 'text-blau']} style="font-variation-settings: 'wdth' 90;">
        {stufe.name}
      </p>

      <p class="mt-3 flex items-baseline gap-2">
        <span class:list={['display display-m', stufe.hervorgehoben ? 'text-bogen' : 'text-blau']}>{stufe.preis}</span>
        <span class={stufe.hervorgehoben ? 'text-bogen/60 text-sm' : 'text-blau-faint text-sm'}>{stufe.einheit}</span>
      </p>

      <p class:list={['mt-3 text-sm leading-relaxed', stufe.hervorgehoben ? 'text-bogen/75' : 'text-blau-soft']}>
        {stufe.beschreibung}
      </p>

      <ul class="mt-6 space-y-2.5 flex-1">
        {stufe.leistungen.map((leistung) => (
          <li class:list={['flex items-start gap-2.5 text-sm', stufe.hervorgehoben ? 'text-bogen/90' : 'text-blau-soft']}>
            <span class:list={['mt-1.5 h-1.5 w-1.5 shrink-0', stufe.hervorgehoben ? 'bg-siegel-hell' : 'bg-siegel']}></span>
            {leistung}
          </li>
        ))}
      </ul>

      <p class:list={['mt-5 text-xs leading-relaxed', stufe.hervorgehoben ? 'text-bogen/60' : 'text-blau-faint']}>
        {stufe.eignung}
      </p>

      {stufe.hinweis && (
        <p class:list={[
          'mt-3 text-xs leading-relaxed px-3 py-2',
          stufe.hervorgehoben ? 'text-siegel-hell border border-siegel-hell/40' : 'text-siegel bg-siegel-blass',
        ]}>
          {stufe.hinweis}
        </p>
      )}

      <a
        href={stufe.cta.href}
        class:list={['knopf mt-6 w-full', stufe.hervorgehoben ? 'knopf-dunkel !border-siegel-hell !text-siegel-hell' : 'knopf-linie']}
        data-tarif-cta={stufe.tarifId}
      >
        {stufe.cta.label}
      </a>

      {stufe.tarifId === 'dossier' && (
        <p class="mt-2 font-mono text-[0.68rem] text-bogen/50 text-center">
          Bestellung per Formular, Rechnung per E-Mail.
        </p>
      )}
    </div>
  ))}
</div>

<!-- Preisanker: das hohe Ticket sichtbar unter der Leiter, nicht im FAQ versteckt. -->
<div class="mt-px border border-linie border-t-0 bg-bogen-rein p-6 sm:p-8 grid lg:grid-cols-[1.4fr_1fr] gap-8 items-center">
  <div>
    <div class="flex items-baseline gap-3 flex-wrap">
      <p class="marginalie">Stufe 04 · persönlich</p>
      <span class="marke marke-gold">Begrenzte Kapazität</span>
    </div>
    <p class="mt-4 font-display font-bold text-blau" style="font-variation-settings: 'wdth' 90;">{ANKER.name}</p>
    <p class="mt-2 flex items-baseline gap-2">
      <span class="display display-m text-blau">{ANKER.preis}</span>
      <span class="text-blau-faint text-sm">{ANKER.einheit}</span>
    </p>
    <p class="mt-3 text-sm text-blau-soft leading-relaxed max-w-xl">{ANKER.beschreibung}</p>
    <ul class="mt-5 grid sm:grid-cols-2 gap-x-6 gap-y-2">
      {ANKER.leistungen.map((leistung) => (
        <li class="flex items-start gap-2.5 text-sm text-blau-soft">
          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-gold"></span>
          {leistung}
        </li>
      ))}
    </ul>
  </div>
  <a href={ANKER.cta.href} class="knopf knopf-siegel w-full lg:w-fit lg:ml-auto" data-tarif-cta={ANKER.tarifId}>
    {ANKER.cta.label}
  </a>
</div>
