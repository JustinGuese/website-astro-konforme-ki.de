---
import { LEITER, ANKER } from '../lib/preise';
import type { Stufe } from '../lib/preise';

interface Props {
  /** Optional: gefilterte/angepasste Anzeige-Kopie der Leiter (z. B. Startseite ohne
   * Dossier-Stufe). Default = die volle `LEITER`. Immer eine Kopie übergeben, nie die
   * geteilten `LEITER`-Objekte mutieren — `ArtikelUpsell.astro` liest dieselben Objekte
   * positionsbasiert. */
  stufen?: Stufe[];
}

const { stufen = LEITER } = Astro.props;
---

<div class:list={['grid gap-px bg-line border border-line', stufen.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3']}>
  {stufen.map((stufe) => (
    <div class:list={['flex flex-col p-6 sm:p-7', stufe.hervorgehoben ? 'bg-ink-deep text-canvas' : 'bg-surface']}>
      <div class="flex items-center justify-between gap-3">
        <p class:list={['marginalie', stufe.hervorgehoben ? 'text-accent-bright' : '']}>Stufe {stufe.nummer}</p>
        {stufe.hervorgehoben && <span class="marke marke-dunkel">Beliebtester Einstieg</span>}
      </div>

      <p class:list={['mt-4 font-display font-bold', stufe.hervorgehoben ? 'text-canvas' : 'text-ink']} style="font-variation-settings: 'wdth' 90;">
        {stufe.name}
      </p>

      <p class="mt-3 flex items-baseline gap-2">
        <span class:list={['display display-m', stufe.hervorgehoben ? 'text-canvas' : 'text-ink']}>{stufe.preis}</span>
        <span class={stufe.hervorgehoben ? 'text-canvas/60 text-sm' : 'text-ink-faint text-sm'}>{stufe.einheit}</span>
      </p>

      <p class:list={['mt-3 text-sm leading-relaxed', stufe.hervorgehoben ? 'text-canvas/75' : 'text-ink-soft']}>
        {stufe.beschreibung}
      </p>

      <ul class="mt-6 space-y-2.5 flex-1">
        {stufe.leistungen.map((leistung) => (
          <li class:list={['flex items-start gap-2.5 text-sm', stufe.hervorgehoben ? 'text-canvas/90' : 'text-ink-soft']}>
            <span class:list={['mt-1.5 h-1.5 w-1.5 shrink-0', stufe.hervorgehoben ? 'bg-accent-bright' : 'bg-accent']}></span>
            {leistung}
          </li>
        ))}
      </ul>

      <p class:list={['mt-5 text-xs leading-relaxed', stufe.hervorgehoben ? 'text-canvas/60' : 'text-ink-faint']}>
        {stufe.eignung}
      </p>

      {stufe.hinweis && (
        <p class:list={[
          'mt-3 text-xs leading-relaxed px-3 py-2',
          stufe.hervorgehoben ? 'text-accent-bright border border-accent-bright/40' : 'text-accent bg-accent-pale',
        ]}>
          {stufe.hinweis}
        </p>
      )}

      <a
        href={stufe.cta.href}
        class:list={['knopf mt-6 w-full', stufe.hervorgehoben ? 'knopf-dunkel !border-accent-bright !text-accent-bright' : 'knopf-linie']}
        data-tarif-cta={stufe.tarifId}
      >
        {stufe.cta.label}
      </a>

      {stufe.tarifId === 'dossier' && (
        <p class="mt-2 font-mono text-[0.68rem] text-canvas/50 text-center">
          Bestellung per Formular, Rechnung per E-Mail.
        </p>
      )}
    </div>
  ))}
</div>

<!-- Preisanker: das hohe Ticket sichtbar unter der Leiter, nicht im FAQ versteckt. -->
<div class="mt-px border border-line border-t-0 bg-surface p-6 sm:p-8 grid lg:grid-cols-[1.4fr_1fr] gap-8 items-center">
  <div>
    <div class="flex items-baseline gap-3 flex-wrap">
      <p class="marginalie">Stufe 04 · persönlich</p>
      <span class="marke marke-premium">Begrenzte Kapazität</span>
    </div>
    <p class="mt-4 font-display font-bold text-ink" style="font-variation-settings: 'wdth' 90;">{ANKER.name}</p>
    <p class="mt-2 flex items-baseline gap-2">
      <span class="display display-m text-ink">{ANKER.preis}</span>
      <span class="text-ink-faint text-sm">{ANKER.einheit}</span>
    </p>
    <p class="mt-3 text-sm text-ink-soft leading-relaxed max-w-xl">{ANKER.beschreibung}</p>
    <ul class="mt-5 grid sm:grid-cols-2 gap-x-6 gap-y-2">
      {ANKER.leistungen.map((leistung) => (
        <li class="flex items-start gap-2.5 text-sm text-ink-soft">
          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-premium"></span>
          {leistung}
        </li>
      ))}
    </ul>
  </div>
  <a href={ANKER.cta.href} class="knopf knopf-accent w-full lg:w-fit lg:ml-auto" data-tarif-cta={ANKER.tarifId}>
    {ANKER.cta.label}
  </a>
</div>
