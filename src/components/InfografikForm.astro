---
import TrackingFields from '@justinguese/astro-kit/TrackingFields.astro';
import { formspreeAction } from '@justinguese/astro-kit/lib/site';
import { site } from '../config/site';

interface Props {
  /**
   * Wohin Formspree nach dem Absenden zurückspringt. Muss auf die Seite
   * zeigen, auf der dieses Formular steht — sonst landet der Nutzer für den
   * Download woanders.
   */
  next?: string;
  /** Herkunft, damit Einsendungen von Startseite und /eu-ki-recht trennbar sind. */
  quelle?: string;
  /** Eigene id, falls das Formular zweimal auf einer Seite steht. */
  id?: string;
}

const {
  next = '/eu-ki-recht?infografik_gesendet=1#infografik',
  quelle = 'eu-ki-recht',
  id = 'infografik',
} = Astro.props;
---

<div id={`${id}-gesendet`} class="hidden border border-accent bg-accent-pale text-ink p-6 text-sm">
  <span class="marke marke-accent mb-3">Angekommen</span>
  <p class="mt-2">Danke! Hier ist Ihre Checkliste als PDF.</p>
  <a
    href="/downloads/eu-ki-recht-checkliste.pdf"
    download
    class="knopf knopf-accent mt-4"
  >
    PDF herunterladen
  </a>
</div>

<form
  id={`${id}-form`}
  action={formspreeAction(site.formspreeId!)}
  method="POST"
  class="bg-surface border border-line p-6 sm:p-7 flex flex-col sm:flex-row gap-4 items-stretch"
>
  <input type="hidden" name="form" value="infografik" />
  <input type="hidden" name="quelle" value={quelle} />
  <input type="hidden" name="tarif" value="checkliste" />
  <input type="hidden" name="_next" value={next} />
  <TrackingFields variant={id} />

  <label for={`${id}-email`} class="sr-only">E-Mail</label>
  <input
    id={`${id}-email`} name="email" type="email" required autocomplete="email"
    class="flex-1 border border-line bg-canvas px-4 py-3 text-base text-ink placeholder-ink-faint focus:outline-none focus:border-accent"
    placeholder="sie@unternehmen.de"
  />
  <button type="submit" class="knopf knopf-accent !py-3 whitespace-nowrap">
    Checkliste per PDF
  </button>
</form>
<p class="mt-3 font-mono text-xs text-ink-faint">
  Keine Weiterleitung an Dritte. Mit dem Absenden stimmen Sie unserer <a href="/datenschutz" class="underline hover:text-ink">Datenschutzerklärung</a> zu.
</p>

<script is:inline define:vars={{ id }}>
  (() => {
    // Zeigt Erfolg/versteckt Formular an; Analytics und URL-Aufräumen
    // übernimmt ConversionTracking auf der Seite (derselbe Flag-Name).
    const params = new URLSearchParams(window.location.search);
    if (params.get('infografik_gesendet') !== '1') return;

    // Beide Instanzen (Startseite + /eu-ki-recht) hören auf denselben
    // Parameter; nur die auf der aktuellen Seite vorhandene reagiert.
    const erfolg = document.getElementById(id + '-gesendet');
    const formular = document.getElementById(id + '-form');
    if (!erfolg || !formular) return;

    erfolg.classList.remove('hidden');
    formular.classList.add('hidden');
  })();
</script>
