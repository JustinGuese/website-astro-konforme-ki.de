---
/**
 * Website-Check-Formular: Web-Adresse + E-Mail. Der Bericht kommt per E-Mail.
 * Feuert serverseitig `Lead` (sites.yaml: mittelstand-check); die Seite, die
 * das Formular einbindet, trägt das passende ConversionTracking.
 */
import FormBlock from '@justinguese/astro-kit/FormBlock.astro';
import { site } from '../../config/site';

interface Props {
  /** Sprungmarke, auf die der Server nach dem Absenden zurückleitet. */
  anker?: string;
  class?: string;
}
const { anker = 'check', class: cls = '' } = Astro.props;
---
<div id={anker} class={cls}>
  <div id="check-gesendet" class="hidden p-5 border border-accent bg-accent-pale text-ink">
    <span class="marke marke-accent mb-2">Angekommen</span>
    <p class="mt-2 font-semibold">Wir prüfen Ihre Website.</p>
    <p class="mt-1 text-sm text-ink-soft">Den Ampelbericht schicken wir Ihnen per E-Mail. Sie müssen nichts weiter tun.</p>
  </div>

  <FormBlock
    formsBase={site.formsBase}
    variant="mittelstand-check"
    name="mittelstand-check"
    success={{ flag: 'check_gesendet', anchor: anker }}
    submitLabel="Website kostenlos prüfen"
    class="check-form space-y-4"
  >
    <div>
      <label for="check-url" class="feld-label">Web-Adresse</label>
      <input id="check-url" name="url" type="text" inputmode="url" required autocomplete="url" class="feld" placeholder="www.ihre-firma.de" />
    </div>
    <div>
      <label for="check-email" class="feld-label">E-Mail für den Bericht</label>
      <input id="check-email" name="email" type="email" required autocomplete="email" class="feld" placeholder="sie@ihre-firma.de" />
    </div>
    <svg slot="submit-icon" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
    <p slot="note" class="mt-3 text-xs text-ink-faint">
      Kostenlos, ohne Vertrag. Es gilt unsere <a href="/datenschutz" class="underline hover:text-ink">Datenschutzerklärung</a>.
    </p>
  </FormBlock>
</div>

<script is:inline>
  if (new URLSearchParams(location.search).get('check_gesendet') === '1') {
    document.getElementById('check-gesendet')?.classList.remove('hidden');
    document.querySelector('.check-form')?.classList.add('hidden');
  }
</script>
