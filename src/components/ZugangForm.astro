---
/**
 * Not wrapped in `@justinguese/astro-kit`'s FormBlock: FormBlock's `_next` is
 * a single value computed once from `success`, and its `submitLabel` is a
 * static string — this form needs both to change client-side after the
 * `?tarif=` param is read (see the script below), which FormBlock has no hook
 * for. TrackingFields is still used directly, which is the part that matters
 * (real UTM/click-id attribution on every submission).
 */
import TrackingFields from '@justinguese/astro-kit/TrackingFields.astro';
import { formspreeAction } from '@justinguese/astro-kit/lib/site';
import { site } from '../config/site';
import { LEITER, ANKER, NUTZUNGSMODELLE } from '../lib/preise';

/**
 * Klartext-Namen für jede `tarifId`, damit in der Formspree-Einsendung nicht
 * nur ein Slug landet. Aus den Preisdaten abgeleitet — eine neue Stufe taucht
 * hier automatisch auf, ohne zweite Liste.
 */
const tarifNamen = Object.fromEntries(
  [...LEITER, ANKER, ...NUTZUNGSMODELLE].map((t) => [t.tarifId, `${t.name} (${t.preis} ${t.einheit})`]),
);
---

<div id="zugang-gesendet" class="hidden border border-accent bg-accent-pale text-ink p-6 text-sm">
  <span class="marke marke-accent mb-3">Angekommen</span>
  <p class="mt-2">Danke! Ihre Anfrage ist angekommen. Sie erhalten Ihren Zugangsschlüssel per E-Mail, in der Regel werktags binnen 24 Stunden.</p>
</div>

<form
  id="zugang-form"
  action={formspreeAction(site.formspreeId!)}
  method="POST"
  class="bg-surface border border-line p-6 sm:p-8 space-y-5"
>
  <input type="hidden" name="form" value="zugang" />
  <input type="hidden" name="_next" id="zugang-next" value="/?zugang_gesendet=1#zugang" />
  <TrackingFields variant="zugang" />

  <!--
    Tarif-Attribution: wird aus `?tarif=` befüllt (siehe zugangHref() in
    lib/preise.ts). Ohne diese beiden Felder sind alle CTAs in der
    Formspree-Inbox ununterscheidbar.
  -->
  <input type="hidden" name="tarif" id="zugang-tarif" value="" />
  <input type="hidden" name="tarif_klartext" id="zugang-tarif-klartext" value="" />

  <div
    id="zugang-tarif-anzeige"
    class="hidden items-center justify-between gap-3 flex-wrap border border-accent bg-accent-pale px-4 py-3"
  >
    <p class="text-sm text-ink">
      Ihr Interesse: <strong class="font-semibold" id="zugang-tarif-label"></strong>
    </p>
    <button type="button" id="zugang-tarif-loeschen" class="font-mono text-xs text-accent underline hover:no-underline">
      ändern
    </button>
  </div>

  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <label for="zugang-email" class="block font-mono text-xs uppercase tracking-wider text-ink-faint mb-1.5">E-Mail</label>
      <input
        id="zugang-email" name="email" type="email" required autocomplete="email"
        class="w-full border border-line bg-canvas px-4 py-3 text-base text-ink placeholder-ink-faint focus:outline-none focus:border-accent"
        placeholder="sie@unternehmen.de"
      />
    </div>
    <div>
      <label for="zugang-firma" class="block font-mono text-xs uppercase tracking-wider text-ink-faint mb-1.5">Unternehmen</label>
      <input
        id="zugang-firma" name="firma" type="text" required autocomplete="organization"
        class="w-full border border-line bg-canvas px-4 py-3 text-base text-ink placeholder-ink-faint focus:outline-none focus:border-accent"
        placeholder="Name Ihres Unternehmens"
      />
    </div>
  </div>

  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <label for="berufsgruppe" class="block font-mono text-xs uppercase tracking-wider text-ink-faint mb-1.5">Branche / Berufsgruppe</label>
      <select id="berufsgruppe" name="berufsgruppe" required class="w-full border border-line bg-canvas px-4 py-3 text-base text-ink focus:outline-none focus:border-accent">
        <option value="">Bitte wählen</option>
        <option value="unternehmen">Unternehmen (kein Berufsgeheimnisträger)</option>
        <option value="steuerberatung">Steuerberatung</option>
        <option value="rechtsanwaltschaft">Rechtsanwaltschaft</option>
        <option value="arztpraxis">Arzt- / Zahnarztpraxis</option>
        <option value="notariat">Notariat</option>
        <option value="psychotherapie">Psychotherapie</option>
        <option value="pflegedienst">Pflegedienst</option>
        <option value="sonstige">Sonstige Berufsgeheimnisträger</option>
      </select>
    </div>
    <div>
      <label for="volumen" class="block font-mono text-xs uppercase tracking-wider text-ink-faint mb-1.5">Anfragevolumen / Monat</label>
      <select id="volumen" name="anfragevolumen" class="w-full border border-line bg-canvas px-4 py-3 text-base text-ink focus:outline-none focus:border-accent">
        <option value="unter-1000">unter 1.000 Anfragen</option>
        <option value="1000-10000">1.000–10.000 Anfragen</option>
        <option value="ueber-10000">über 10.000 Anfragen</option>
        <option value="weiss-nicht">weiß ich noch nicht</option>
      </select>
    </div>
  </div>

  <div>
    <label for="ki-nutzung" class="block font-mono text-xs uppercase tracking-wider text-ink-faint mb-1.5">Bestehende KI-Nutzung</label>
    <select id="ki-nutzung" name="ki_nutzung" class="w-full border border-line bg-canvas px-4 py-3 text-base text-ink focus:outline-none focus:border-accent">
      <option value="keine">Noch keine</option>
      <option value="chatgpt-privat">ChatGPT / privat, ungeregelt</option>
      <option value="azure-openai">Azure OpenAI o. ä. (mit AVV)</option>
      <option value="anderer-eu-anbieter">Anderer EU-Anbieter</option>
    </select>
  </div>

  <button type="submit" class="knopf knopf-accent w-full !py-4">
    <span id="zugang-absenden-label">Zugangsschlüssel sichern</span>
    <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
  </button>

  <p class="font-mono text-xs text-ink-faint text-center">
    Zugangsschlüssel per E-Mail, werktags binnen 24 Stunden. Mit dem Absenden stimmen Sie unserer <a href="/datenschutz" class="underline hover:text-ink">Datenschutzerklärung</a> zu.
  </p>
</form>

<script is:inline define:vars={{ tarifNamen }}>
  (() => {
    const params = new URLSearchParams(window.location.search);

    // --- Erfolgszustand nach dem Formspree-Redirect -------------------------
    // Zeigt Erfolg/versteckt Formular; Analytics und URL-Aufräumen übernimmt
    // ConversionTracking auf der Seite (derselbe Flag-Name).
    if (params.get('zugang_gesendet') === '1') {
      document.getElementById('zugang-gesendet')?.classList.remove('hidden');
      document.getElementById('zugang-form')?.classList.add('hidden');
      return;
    }

    // --- Tarif-Attribution aus `?tarif=` -----------------------------------
    const feld = document.getElementById('zugang-tarif');
    const feldKlartext = document.getElementById('zugang-tarif-klartext');
    const anzeige = document.getElementById('zugang-tarif-anzeige');
    const label = document.getElementById('zugang-tarif-label');
    const next = document.getElementById('zugang-next');
    const absendenLabel = document.getElementById('zugang-absenden-label');
    if (!feld) return;

    // Der Knopf muss sagen, was er tut — eine €39-Bestellung ist keine
    // „Zugangsanfrage". Nur Stufen, die hier abweichen, brauchen einen Eintrag.
    const absendenTexte = {
      dossier: 'Dossier kostenpflichtig bestellen',
      onboarding: 'Machbarkeits-Check anfragen',
    };

    const setzen = (tarif) => {
      feld.value = tarif || '';
      if (feldKlartext) feldKlartext.value = tarif ? (tarifNamen[tarif] || tarif) : '';
      // Tarif über den Redirect hinweg mitnehmen, damit das Lead-Ereignis
      // weiß, welches Angebot konvertiert hat.
      if (next) {
        next.value = tarif
          ? `/?zugang_gesendet=1&tarif=${encodeURIComponent(tarif)}#zugang`
          : '/?zugang_gesendet=1#zugang';
      }
      if (absendenLabel) {
        absendenLabel.textContent = (tarif && absendenTexte[tarif]) || 'Zugangsschlüssel sichern';
      }
      if (anzeige && label) {
        if (tarif && tarifNamen[tarif]) {
          label.textContent = tarifNamen[tarif];
          anzeige.classList.remove('hidden');
          anzeige.classList.add('flex');
        } else {
          anzeige.classList.add('hidden');
          anzeige.classList.remove('flex');
        }
      }
    };

    setzen(params.get('tarif'));

    document.getElementById('zugang-tarif-loeschen')?.addEventListener('click', () => {
      setzen(null);
      const p = new URLSearchParams(window.location.search);
      p.delete('tarif');
      const qs = p.toString();
      window.history.replaceState({}, '', window.location.pathname + (qs ? '?' + qs : '') + window.location.hash);
    });
  })();
</script>
