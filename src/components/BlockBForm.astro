---
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_BLOCK_B_ID || 'REPLACE_WITH_FORMSPREE_ID';
const landingPage = Astro.url.pathname;
---
<form
  action={`https://formspree.io/f/${formspreeId}`}
  method="POST"
  class="bg-paper border-[1.5px] border-ink/80 p-6 sm:p-8 space-y-5"
>
  <input type="hidden" name="form" value="block_b" />
  <input type="hidden" name="landing_page" value={landingPage} />
  <input type="hidden" name="_next" value={`${landingPage}?block_b=1#demo`} />
  <input type="text" name="_gotcha" style="display:none" />

  <div>
    <label for="eingangskanal" class="block font-mono text-xs uppercase tracking-wider text-ink-faint mb-1.5">Wie kommen Prüfanfragen bei Ihnen an?</label>
    <select id="eingangskanal" name="eingangskanal" required
      class="w-full border-[1.5px] border-line bg-paper px-4 py-3 text-base text-ink focus:outline-none focus:border-ink">
      <option value="">Bitte wählen…</option>
      <option value="post">Post</option>
      <option value="fax">Fax</option>
      <option value="email">E-Mail</option>
      <option value="kassenportal">Kassenportal</option>
      <option value="gemischt">Gemischt</option>
    </select>
  </div>

  <div>
    <label for="pflegedoku" class="block font-mono text-xs uppercase tracking-wider text-ink-faint mb-1.5">In welchem System liegt Ihre Pflegedokumentation?</label>
    <select id="pflegedoku" name="pflegedoku_system" required
      class="w-full border-[1.5px] border-line bg-paper px-4 py-3 text-base text-ink focus:outline-none focus:border-ink">
      <option value="">Bitte wählen…</option>
      <option value="medifox">MediFox</option>
      <option value="vivendi">Vivendi</option>
      <option value="snap">Snap</option>
      <option value="dan">DAN</option>
      <option value="papier">Papier</option>
      <option value="anderes">Anderes</option>
    </select>
  </div>

  <div>
    <label for="pdf_export" class="block font-mono text-xs uppercase tracking-wider text-ink-faint mb-1.5">Können Sie daraus einzelne Vorgänge als PDF exportieren?</label>
    <select id="pdf_export" name="pdf_export_moeglich" required
      class="w-full border-[1.5px] border-line bg-paper px-4 py-3 text-base text-ink focus:outline-none focus:border-ink">
      <option value="">Bitte wählen…</option>
      <option value="ja">Ja</option>
      <option value="nein">Nein</option>
      <option value="weiss_nicht">Weiß ich nicht</option>
    </select>
  </div>

  <button
    type="submit"
    class="w-full inline-flex items-center justify-center gap-2 px-6 py-4 text-base font-semibold text-paper bg-ink hover:bg-[color-mix(in_srgb,var(--color-ink)_88%,black)] transition-colors"
  >
    Demo freischalten
    <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
  </button>
</form>
