---
type Status = 'verfuegbar' | 'in-vorbereitung' | 'auf-anfrage';

interface Props {
  name: string;
  status: Status;
  beschreibung: string;
  rekordBeispiel: string;
}

const { name, status, beschreibung, rekordBeispiel } = Astro.props;

const statusLabel: Record<Status, string> = {
  'verfuegbar': 'Verfügbar',
  'in-vorbereitung': 'In Vorbereitung',
  'auf-anfrage': 'Auf Anfrage',
};

const statusKlasse: Record<Status, string> = {
  'verfuegbar': 'marke-siegel',
  'in-vorbereitung': 'marke-neutral',
  'auf-anfrage': 'marke-neutral',
};
---

<div class="bg-bogen-rein border border-linie p-6 flex flex-col gap-3">
  <div class="flex items-start justify-between gap-3">
    <p class="font-display font-bold text-blau" style="font-variation-settings: 'wdth' 90;">{name}</p>
    <span class={`marke ${statusKlasse[status]} shrink-0`}>{statusLabel[status]}</span>
  </div>
  <p class="text-sm text-blau-soft leading-relaxed">{beschreibung}</p>
  <code class="mt-1 font-mono text-xs text-blau-faint bg-bogen-tief px-2.5 py-1.5 border border-linie w-fit break-all">{rekordBeispiel}</code>
</div>
