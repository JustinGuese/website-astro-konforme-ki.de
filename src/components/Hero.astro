---
interface Props {
  title: string;
  subtitle: string;
  ctaText?: string;
  ctaHref?: string;
  bullets?: string[];
  stats?: { value: string; label: string }[];
}

const {
  title,
  subtitle,
  ctaText = 'Kostenloses Compliance-Paket sichern',
  ctaHref = '#stufe-1',
  bullets = ['§203-konform', 'AVV inklusive', 'Kein automatisierter Bescheid'],
  stats = [
    { value: '€0', label: 'Einstieg' },
    { value: '5', label: 'Werktage' },
    { value: '3', label: 'Stufen' }
  ],
} = Astro.props;
---
<section class="relative overflow-hidden bg-paper">
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 opacity-[0.035]"
    style="background-image: repeating-linear-gradient(0deg, var(--color-ink) 0, var(--color-ink) 1px, transparent 1px, transparent 28px); mask-image: linear-gradient(to bottom, black, transparent 85%);"
  ></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-16 sm:pt-20 sm:pb-24">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      <div class="lg:col-span-7">
        <div class="flex flex-wrap items-center gap-3">
          <span class="tag tag-az">Für Pflegedienste · MVZ · Arztpraxen</span>
        </div>

        <div class="mt-6 flex items-start gap-4">
          <h1 class="font-display text-[2.6rem] sm:text-6xl lg:text-[4.2rem] font-black tracking-[-0.02em] text-ink leading-[0.96]">
            {title}
          </h1>
          <span class="tag tag-stamp stamp-in shrink-0 mt-2 hidden sm:inline-flex">Frist</span>
        </div>

        <p class="mt-6 text-lg sm:text-xl text-ink-soft max-w-xl leading-relaxed">
          {subtitle}
        </p>

        <div class="mt-9">
          <a
            href={ctaHref}
            class="group inline-flex items-center justify-center gap-3 px-8 py-4 text-base sm:text-lg font-semibold text-paper bg-stamp hover:bg-[color-mix(in_srgb,var(--color-stamp)_88%,black)] shadow-[4px_4px_0_0_var(--color-ink)] hover:shadow-[2px_2px_0_0_var(--color-ink)] hover:translate-x-[2px] hover:translate-y-[2px] transition-all"
          >
            {ctaText}
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
          </a>
          <p class="mt-3 font-mono text-xs text-ink-faint">Kein Vertrag · keine Kreditkarte · in 2 Minuten ausgefüllt</p>
        </div>

        <div class="mt-8 flex flex-wrap gap-2.5">
          {bullets.map(b => (
            <span class="tag tag-az">{b}</span>
          ))}
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="relative mt-2">
          <div class="absolute -top-3 left-6 w-32 h-6 bg-paper-deep border-[1.5px] border-b-0 border-line"></div>
          <div class="relative bg-paper-deep border-[1.5px] border-ink/80 p-6 sm:p-7">
            <div class="flex items-center justify-between pb-4 border-b border-line">
              <span class="font-mono text-[11px] tracking-wider text-ink-faint">AZ. PN-2026-001</span>
              <span class="font-mono text-[11px] tracking-wider text-ink-faint">STUFE 1 / 3</span>
            </div>

            <p class="mt-5 font-mono text-[11px] uppercase tracking-widest text-ink-faint">Enthalten</p>
            <ul class="mt-3 space-y-2.5">
              <li class="flex items-start gap-2.5 text-sm text-ink">
                <span class="mt-1 h-1.5 w-1.5 shrink-0 bg-stamp"></span>
                KI-Entwurf mit Quellenverweisen
              </li>
              <li class="flex items-start gap-2.5 text-sm text-ink">
                <span class="mt-1 h-1.5 w-1.5 shrink-0 bg-stamp"></span>
                Ihre Prüfung & Kontrolle
              </li>
              <li class="flex items-start gap-2.5 text-sm text-ink">
                <span class="mt-1 h-1.5 w-1.5 shrink-0 bg-stamp"></span>
                Versand bleibt bei Ihnen
              </li>
            </ul>

            <div class="mt-6 pt-5 border-t border-line grid grid-cols-3 gap-3 text-center">
              {stats.map(stat => (
                <div>
                  <div class="font-display text-2xl font-black text-ink leading-none">{stat.value}</div>
                  <div class="mt-1 font-mono text-[10px] uppercase tracking-wider text-ink-faint">{stat.label}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
