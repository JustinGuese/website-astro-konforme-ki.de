---
interface Cta {
  label: string;
  href: string;
}

interface Props {
  marginalie: string;
  primaryCta: Cta;
  secondaryCta: Cta;
}

const { marginalie, primaryCta, secondaryCta } = Astro.props;
---

<div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
  <div>
    <p class="marginalie mb-5">{marginalie}</p>
    <h1 class="display display-xl text-blau">
      <slot name="titel" />
    </h1>
    <p class="mt-6 text-lg text-blau-soft leading-relaxed max-w-xl">
      <slot name="subtitel" />
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href={primaryCta.href} class="knopf knopf-siegel">
        {primaryCta.label}
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
      </a>
      <a href={secondaryCta.href} class="knopf knopf-linie">
        {secondaryCta.label}
      </a>
    </div>
    <div class="mt-5">
      <slot name="hinweis" />
    </div>
    <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
      <slot name="bullets" />
    </div>
  </div>

  <div>
    <slot />
  </div>
</div>
