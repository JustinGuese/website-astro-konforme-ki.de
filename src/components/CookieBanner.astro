---
---
<div id="cookie-banner" class="kein-druck fixed bottom-0 left-0 right-0 bg-bogen-rein border-t border-linie p-6 shadow-[var(--shadow-karte-hoch)] transform translate-y-full transition-transform duration-500 z-[100] hidden">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="text-sm text-blau-soft leading-relaxed max-w-3xl">
            Wir verwenden Cookies für Reichweitenmessung und Werbeanzeigen erst nach Ihrer Zustimmung. Details in unserer <a href="/datenschutz" class="text-siegel font-semibold hover:underline underline-offset-4">Datenschutzerklärung</a>.
        </div>
        <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto shrink-0">
            <button id="decline-cookies" class="knopf knopf-linie flex-1 sm:flex-none !py-2.5">
                Alle ablehnen
            </button>
            <button id="accept-cookies" class="knopf knopf-siegel flex-1 sm:flex-none !py-2.5">
                Alle akzeptieren
            </button>
        </div>
    </div>
</div>

<script>
    function initCookieBanner() {
        const banner = document.getElementById('cookie-banner');
        const acceptBtn = document.getElementById('accept-cookies');
        const declineBtn = document.getElementById('decline-cookies');

        if (!banner || !acceptBtn || !declineBtn) return;

        const consent = localStorage.getItem('cookie-consent');
        if (consent === null) {
            banner.classList.remove('hidden');
            requestAnimationFrame(() => {
                setTimeout(() => {
                    banner.classList.remove('translate-y-full');
                }, 10);
            });
        }

        const closeBanner = () => {
            banner.classList.add('translate-y-full');
            setTimeout(() => {
                banner.classList.add('hidden');
            }, 500);
        };

        acceptBtn.addEventListener('click', () => {
            localStorage.setItem('cookie-consent', 'true');
            window.dispatchEvent(new CustomEvent('cookie-consent-updated', { detail: { accepted: true } }));
            closeBanner();
        });

        declineBtn.addEventListener('click', () => {
            localStorage.setItem('cookie-consent', 'false');
            window.dispatchEvent(new CustomEvent('cookie-consent-updated', { detail: { accepted: false } }));
            closeBanner();
        });
    }

    initCookieBanner();
    document.addEventListener('astro:after-swap', initCookieBanner);
</script>
