---
/**
 * ProofBlock's default stat card is a dark, --color-premium-bright-accented
 * tile — this site reserves premium exclusively for Säule 3, and this section
 * sits on a light background, so `.belege-hell` below overrides both back to
 * the site's own light-card/accent-number look. No quotes: see belege.ts for
 * why (§ 5 UWG).
 */
import ProofBlock from '@justinguese/astro-kit/ProofBlock.astro';
import { SIEGEL } from '../lib/belege';
---

<ProofBlock class="belege-hell" stats={SIEGEL.map((k) => ({ value: k.wert, label: k.label }))} />
