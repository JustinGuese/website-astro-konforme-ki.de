---
import { SIEGEL } from '../lib/belege';
---

<!-- Nachprüfbare Aussagen — Produkteigenschaften statt Kundenzitaten, die wir
     noch nicht haben. Siehe die Begründung in src/lib/belege.ts. -->
<dl class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-linie border border-linie">
  {SIEGEL.map((k) => (
    <div class="bg-bogen-rein p-7">
      <dt class="display display-xl text-siegel">{k.wert}</dt>
      <dd class="mt-2 text-sm text-blau-soft leading-relaxed">{k.label}</dd>
    </div>
  ))}
</dl>
