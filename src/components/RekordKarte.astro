---
interface Feld {
  schluessel: string;
  wert: string;
  ton?: 'ok' | 'signal';
}

interface Props {
  kopf: string;
  felder: Feld[];
  fuss?: string;
  class?: string;
  /** 'beispiel' (Standard) für handgeschriebene Beispieldaten; 'live' nur,
   * wenn der Rekord tatsächlich aus einer echten Anfrage stammt. Nie
   * hardcoden — sonst behauptet die Seite eine Live-Inferenz, die sie im
   * Demo-Betrieb nicht liefert (siehe AGENTS.md zum Playground). */
  status?: 'beispiel' | 'live';
}

const { kopf, felder, fuss, class: klasse = '', status = 'beispiel' } = Astro.props;
---

<div class:list={['rekord', klasse]}>
  <div class="rekord-kopf">
    <span>{kopf}</span>
    <span class="inline-flex items-center gap-1.5">
      <span class:list={['h-1.5 w-1.5 rounded-full', status === 'live' ? 'bg-accent-bright' : 'bg-ink-faint']}></span>
      {status}
    </span>
  </div>
  {felder.map((feld) => (
    <div class="rekord-zeile">
      <span class="rekord-schluessel">{feld.schluessel}</span>
      <span class:list={['rekord-wert', feld.ton === 'ok' && 'rekord-wert-ok', feld.ton === 'signal' && 'rekord-wert-signal']}>
        {feld.wert}
      </span>
    </div>
  ))}
  {fuss && <div class="rekord-fuss">{fuss}</div>}
</div>
