---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "pflegenachweis.de — Prüfanfragen compliant beantworten",
  description = "KI-gestützte, §203-konforme Unterstützung bei Pflegegrad-Prüfungen, §275 SGB V Abrechnungsprüfungen und Prüfanfragen mit Frist. Kostenloses Compliance-Paket."
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800;900&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/og-image.svg", Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL("/og-image.svg", Astro.url)} />

    <slot name="head" />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-6F42PQXVQ7"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-6F42PQXVQ7');
    </script>
    <!-- End Google tag -->

    <!-- Meta Pixel Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1785955559052587');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=1785955559052587&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Code -->
  </head>
  <body class="bg-paper text-ink font-sans antialiased flex flex-col min-h-screen">
    <header class="border-b-[1.5px] border-line py-3.5 relative z-50 bg-paper">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center gap-4">
        <a href="/" class="flex items-center gap-2.5 group">
          <span class="inline-flex h-8 w-8 items-center justify-center bg-ink text-paper font-mono text-[11px] font-bold tracking-wide">PN</span>
          <span class="font-display font-extrabold text-lg tracking-tight text-ink">pflegenachweis<span class="text-stamp">.de</span></span>
        </a>

        <div class="flex items-center gap-4 ml-auto">
          <div class="hidden sm:flex items-center gap-4 text-sm text-ink-soft">
            <a href="/kontakt" class="hover:text-ink transition-colors">Kontakt</a>
            <span class="text-line">·</span>
            <a href="/impressum" class="hover:text-ink transition-colors">Impressum</a>
            <span class="text-line">·</span>
            <a href="/agb" class="hover:text-ink transition-colors">AGB</a>
            <span class="text-line">·</span>
            <a href="/datenschutz" class="hover:text-ink transition-colors">Datenschutz</a>
          </div>
          <a href="#stufe-1" class="inline-flex items-center gap-2 bg-stamp text-paper px-4 py-2 text-sm font-semibold hover:bg-[color-mix(in_srgb,var(--color-stamp)_88%,black)] transition-colors">
            Compliance-Paket <span class="hidden sm:inline">· kostenlos</span>
          </a>
        </div>
      </nav>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="bg-paper-deep border-t-[1.5px] border-line py-10 mt-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-sm text-ink-soft">
        <div class="flex flex-wrap justify-center gap-x-5 gap-y-2">
          <a href="/impressum" class="hover:text-ink">Impressum</a>
          <a href="/datenschutz" class="hover:text-ink">Datenschutzerklärung</a>
          <a href="/agb" class="hover:text-ink">AGB</a>
          <a href="/rdg-hinweis" class="hover:text-ink">RDG-Hinweis</a>
        </div>
        <p class="mt-4 font-mono text-xs text-ink-faint">&copy; {new Date().getFullYear()} DataFortress.cloud GmbH — Gewerbestraße 13, 82064 Straßlach-Dingharting</p>
      </div>
    </footer>
    <CookieBanner />

    <div
      id="sticky-cta"
      class="md:hidden fixed inset-x-0 bottom-0 z-40 translate-y-full opacity-0 transition-all duration-300 pointer-events-none"
      aria-hidden="true"
    >
      <div class="bg-paper/95 backdrop-blur border-t-[1.5px] border-line shadow-[0_-4px_20px_rgba(21,24,27,0.12)] px-4 py-3 pb-[calc(env(safe-area-inset-bottom)+0.75rem)]">
        <a
          href="#stufe-1"
          class="flex items-center justify-center gap-2 w-full py-3.5 text-base font-semibold text-paper bg-stamp active:scale-[0.98] transition-transform"
        >
          Kostenloses Compliance-Paket sichern
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
        </a>
      </div>
    </div>

    <script is:inline>
      (() => {
        const bar = document.getElementById('sticky-cta');
        if (!bar) return;
        const show = () => {
          bar.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
          bar.setAttribute('aria-hidden', 'false');
        };
        const hide = () => {
          bar.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
          bar.setAttribute('aria-hidden', 'true');
        };

        const stufe1 = document.getElementById('stufe-1');
        const finale = document.getElementById('stufe-3');
        const observed = [stufe1, finale].filter(Boolean);

        if ('IntersectionObserver' in window && observed.length) {
          let visibleAnchors = 0;
          const io = new IntersectionObserver((entries) => {
            entries.forEach(e => { visibleAnchors += e.isIntersecting ? 1 : -1; });
            visibleAnchors = Math.max(0, visibleAnchors);
            if (window.scrollY > 400 && visibleAnchors === 0) show(); else hide();
          }, { threshold: 0.05 });
          observed.forEach(el => io.observe(el));
          window.addEventListener('scroll', () => {
            if (window.scrollY > 400 && visibleAnchors === 0) show(); else if (window.scrollY <= 400) hide();
          }, { passive: true });
        } else {
          window.addEventListener('scroll', () => {
            if (window.scrollY > 400) show(); else hide();
          }, { passive: true });
        }
      })();
    </script>
  </body>
</html>
