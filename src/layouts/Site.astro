---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import { KONTINGENT, frei } from '../lib/kontingent';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Setzt og:type=article und die Artikel-Metadaten. */
  artikel?: { veroeffentlicht?: string; geaendert?: string; kategorie?: string };
}

const {
  title = 'Nachweis — die KI-Schnittstelle, die Ihrem Datenschutzbeauftragten die Freigabe schreibt',
  description = 'Sidecar-Prüfspur über Ihre bestehende KI — oder gehostete EU-Inferenz. Exportierbare, hash-verkettete Beweiskette für Datenschutzbeauftragte und Betriebsrat. Kein US-Fallback, kein Training auf Ihren Daten.',
  noindex = false,
  artikel,
} = Astro.props;

const ga4Id = (import.meta.env.PUBLIC_GA4_ID as string | undefined) || 'G-S1XYB7MX9M';
const metaPixelId = (import.meta.env.PUBLIC_META_PIXEL_ID as string | undefined) || '1590666016030768';

/** Kanonische URL ohne Query/Hash — sonst indiziert Google `?tarif=…`-Varianten. */
const kanonisch = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href.replace(/\/$/, '') || '/';

/** Ratgeber ist ein Aufklappmenü; alle anderen Einträge sind einfache Links. */
const nav: { href: string; label: string; kinder?: { href: string; label: string; kurz: string }[] }[] = [
  { href: '/playground', label: 'Playground' },
  {
    href: '/ratgeber',
    label: 'Ratgeber',
    kinder: [
      { href: '/ratgeber/chatgpt-kanzlei-datenschutz', label: 'ChatGPT in der Kanzlei', kurz: 'Was § 203 StGB Anwälten verbietet' },
      { href: '/ratgeber/chatgpt-steuerberater', label: 'ChatGPT für Steuerberater', kurz: 'Mandantendaten, DSGVO und § 203' },
      { href: '/ratgeber/ki-arztpraxis-datenschutz', label: 'KI in der Arztpraxis', kurz: 'Art. 9 DSGVO und Patientendaten' },
      { href: '/ratgeber/avv-ki-anbieter', label: 'AVV für KI-Anbieter', kurz: 'Was nach Art. 28 DSGVO drinstehen muss' },
      { href: '/ratgeber/verarbeitungsverzeichnis-ki', label: 'KI im Verarbeitungsverzeichnis', kurz: 'Der Art. 30-Eintrag, Feld für Feld' },
      { href: '/ratgeber/dsgvo-konforme-ki-alternativen', label: 'DSGVO-konforme KI-Alternativen', kurz: 'EU-gehostete Modelle im Vergleich' },
    ],
  },
  { href: '/unterlagen', label: 'Unterlagen' },
];
/**
 * EU-KI-Recht, Integrationen und Preise bewusst nicht in der Kopfzeile:
 * die auf jeder Sektion sichtbare Navigation soll nicht mit dem einen CTA
 * konkurrieren, den der Seitenkörper konsequent wiederholt. Alle drei
 * bleiben erreichbar — inline auf der Startseite und im Footer.
 */
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Martian+Mono:wght@600;700&family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <link rel="canonical" href={kanonisch} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={artikel ? 'article' : 'website'} />
    <meta property="og:url" content={kanonisch} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Nachweis" />
    <meta property="og:image" content={new URL('/og-image.svg', Astro.url)} />
    {artikel?.veroeffentlicht && <meta property="article:published_time" content={artikel.veroeffentlicht} />}
    {artikel?.geaendert && <meta property="article:modified_time" content={artikel.geaendert} />}
    {artikel?.kategorie && <meta property="article:section" content={artikel.kategorie} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL('/og-image.svg', Astro.url)} />

    <slot name="head" />

    <!--
      Consent Mode v2 — muss vor jedem gtag-Aufruf stehen und beginnt
      abgelehnt. Ein Compliance-Produkt, das ungefragt trackt, ist nicht
      glaubwürdig. CookieBanner.astro löst 'cookie-consent-updated' aus;
      dieses Skript hört darauf und lädt GA4/Meta Pixel erst danach.
    -->
    <script is:inline define:vars={{ ga4Id, metaPixelId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
      });

      function ladeGA4() {
        if (!ga4Id || window.__ga4Geladen) return;
        window.__ga4Geladen = true;
        const s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
        document.head.appendChild(s);
        gtag('js', new Date());
        gtag('config', ga4Id, { anonymize_ip: true });
      }

      function ladeMetaPixel() {
        if (!metaPixelId || window.__pixelGeladen) return;
        window.__pixelGeladen = true;
        !function (f, b, e, v, n, t, s) {
          if (f.fbq) return; n = f.fbq = function () {
            n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
          };
          if (!f._fbq) f._fbq = n; n.push = n; n.loaded = !0; n.version = '2.0';
          n.queue = []; t = b.createElement(e); t.async = !0; t.src = v;
          s = b.getElementsByTagName(e)[0]; s.parentNode.insertBefore(t, s);
        }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
        window.fbq('init', metaPixelId);
        window.fbq('track', 'PageView');
      }

      /**
       * Consent Mode stoppt nur KÜNFTIGES Speichern, löscht aber nichts, was
       * bereits auf dem Gerät liegt. Ein Widerruf erwartet, dass die
       * Kennungen tatsächlich verschwinden — also explizit löschen. Das
       * Löschen eines Cookies erfordert Pfad UND Domain, die wir nicht
       * kennen, daher wird der aktuelle Host und jede Elterndomain versucht.
       */
      function trackerCookiesLoeschen() {
        const praefixe = ['_ga', '_gid', '_gat', '_gac_', '_fbp', '_fbc'];
        const teile = window.location.hostname.split('.');
        const domains = [undefined];
        for (let i = 0; i < teile.length - 1; i++) domains.push('.' + teile.slice(i).join('.'));

        document.cookie.split('; ').forEach((eintrag) => {
          const name = eintrag.split('=')[0];
          if (!praefixe.some((p) => name.startsWith(p))) return;
          domains.forEach((domain) => {
            document.cookie =
              name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' +
              (domain ? '; domain=' + domain : '');
          });
        });
      }

      function anwendenEinwilligung(akzeptiert) {
        gtag('consent', 'update', {
          ad_storage: akzeptiert ? 'granted' : 'denied',
          ad_user_data: akzeptiert ? 'granted' : 'denied',
          ad_personalization: akzeptiert ? 'granted' : 'denied',
          analytics_storage: akzeptiert ? 'granted' : 'denied',
        });
        if (akzeptiert) {
          ladeGA4();
          ladeMetaPixel();
          return;
        }
        trackerCookiesLoeschen();
      }

      window.addEventListener('cookie-consent-updated', (e) => anwendenEinwilligung(e.detail.accepted));

      const bestehendeEinwilligung = localStorage.getItem('cookie-consent');
      if (bestehendeEinwilligung === 'true') anwendenEinwilligung(true);
    </script>
  </head>
  <body class="bg-bogen text-blau font-sans antialiased flex flex-col min-h-screen">
    <div class="kette-strich" id="kette-strich"></div>

    <header class="border-b border-linie py-3.5 relative z-50 bg-bogen/95 backdrop-blur">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center gap-4">
        <a href="/" class="flex items-center gap-2.5 group shrink-0">
          <span class="inline-flex h-8 w-8 items-center justify-center bg-blau text-bogen font-mono text-xs font-bold">K</span>
          <span class="font-display text-[15px] font-bold tracking-tight text-blau" style="font-variation-settings: 'wdth' 90;">
            konforme-ki<span class="text-siegel">.de</span>
          </span>
        </a>

        <div class="hidden lg:flex items-center gap-6 text-sm text-blau-soft">
          {/*
            Aufklappmenü ohne JS: <details> öffnet per Klick und ist per
            Tastatur bedienbar. Ein reines :hover-Menü wäre auf Touch-Geräten
            nicht erreichbar.
          */}
          {nav.map((item) => (item.kinder ? (
            <details class="menue relative">
              <summary class="flex items-center gap-1.5 cursor-pointer list-none hover:text-blau transition-colors">
                {item.label}
                <svg class="h-3 w-3 transition-transform" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                </svg>
              </summary>
              <div class="menue-tafel absolute left-1/2 -translate-x-1/2 top-full mt-3 w-[22rem] border border-linie bg-bogen-rein shadow-[var(--shadow-karte-hoch)]">
                <a href={item.href} class="block px-5 py-3.5 border-b border-linie hover:bg-bogen-tief transition-colors">
                  <span class="marginalie">Alle Ratgeber</span>
                  <span class="mt-1 block text-sm font-semibold text-blau">Übersicht ansehen →</span>
                </a>
                {item.kinder.map((kind) => (
                  <a href={kind.href} class="block px-5 py-3 border-b border-linie last:border-b-0 hover:bg-bogen-tief transition-colors">
                    <span class="block text-sm font-semibold text-blau">{kind.label}</span>
                    <span class="mt-0.5 block text-xs text-blau-faint leading-snug">{kind.kurz}</span>
                  </a>
                ))}
              </div>
            </details>
          ) : (
            <a href={item.href} class="hover:text-blau transition-colors">{item.label}</a>
          )))}
        </div>

        <a href="/?tarif=compliance#zugang" class="knopf knopf-siegel !py-2 !px-3 sm:!px-4 !text-sm shrink-0" data-tarif-cta="header">
          <!-- Auf sehr schmalen Geräten würde die Langform Kopfzeile und Seite
               horizontal aufschieben; unten steht ohnehin die Sticky-Leiste. -->
          <span class="sm:hidden">Zugang</span>
          <span class="hidden sm:inline">Zugangsschlüssel sichern</span>
        </a>
      </nav>
    </header>

    <main class="flex-grow">
      <slot name="kette" />
      <slot />
    </main>

    <footer class="bg-bogen-tief border-t border-linie py-10 mt-12 kein-druck">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-8 text-sm">
          <div>
            <span class="font-display text-sm font-bold text-blau" style="font-variation-settings: 'wdth' 90;">konforme-ki<span class="text-siegel">.de</span></span>
            <p class="mt-3 text-blau-faint leading-relaxed">Prüfspur über Ihre bestehende KI oder gehostete EU-Inferenz.</p>
          </div>
          <div>
            <p class="marginalie mb-3">Produkt</p>
            <div class="flex flex-col gap-2 text-blau-soft">
              <a href="/playground" class="hover:text-blau">Playground</a>
              <a href="/integrationen" class="hover:text-blau">Integrationen</a>
              <a href="/preise" class="hover:text-blau">Preise</a>
            </div>
          </div>
          <div>
            <p class="marginalie mb-3">Recht &amp; Nachweis</p>
            <div class="flex flex-col gap-2 text-blau-soft">
              <a href="/eu-ki-recht" class="hover:text-blau">EU-KI-Recht</a>
              <a href="/unterlagen" class="hover:text-blau">Unterlagen</a>
              <a href="/kontakt" class="hover:text-blau" data-contact-cta="footer">Kontakt</a>
            </div>
          </div>
          <div>
            <p class="marginalie mb-3">Ratgeber</p>
            <div class="flex flex-col gap-2 text-blau-soft">
              {nav.find((n) => n.href === '/ratgeber')?.kinder?.slice(0, 4).map((kind) => (
                <a href={kind.href} class="hover:text-blau">{kind.label}</a>
              ))}
              <a href="/ratgeber" class="text-siegel hover:underline">Alle Ratgeber →</a>
            </div>
          </div>
          <div>
            <p class="marginalie mb-3">Rechtliches</p>
            <div class="flex flex-col gap-2 text-blau-soft">
              <a href="/impressum" class="hover:text-blau">Impressum</a>
              <a href="/datenschutz" class="hover:text-blau">Datenschutzerklärung</a>
              <a href="/agb" class="hover:text-blau">AGB</a>
              <a href="/rdg-hinweis" class="hover:text-blau">RDG-Hinweis</a>
              <button type="button" data-consent-reopen class="text-left hover:text-blau cursor-pointer underline-offset-4 hover:underline">
                Cookie-Einstellungen
              </button>
            </div>
          </div>
        </div>
        <p class="mt-10 font-mono text-xs text-blau-faint">&copy; {new Date().getFullYear()} DataFortress.cloud GmbH — Gewerbestraße 13, 82064 Straßlach-Dingharting</p>
      </div>
    </footer>
    <CookieBanner />

    <div
      id="sticky-cta"
      class="lg:hidden fixed inset-x-0 bottom-0 z-40 translate-y-full opacity-0 transition-all duration-300 pointer-events-none kein-druck"
      aria-hidden="true"
    >
      <div class="bg-bogen-rein/95 backdrop-blur border-t border-linie shadow-[0_-4px_20px_rgba(23,36,63,0.10)] px-4 py-3 pb-[calc(env(safe-area-inset-bottom)+0.75rem)]">
        <p class="mb-2 font-mono text-[0.68rem] text-blau-faint text-center">
          Noch {frei} von {KONTINGENT.plaetze} Zugangsschlüsseln diesen Monat frei
        </p>
        <a href="/?tarif=compliance#zugang" class="knopf knopf-siegel w-full active:scale-[0.98]" data-tarif-cta="sticky">
          Zugangsschlüssel sichern
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
        </a>
      </div>
    </div>

    <script is:inline>
      (() => {
        const bar = document.getElementById('sticky-cta');
        const strich = document.getElementById('kette-strich');

        const updateStrich = () => {
          if (!strich) return;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const pct = max > 0 ? (window.scrollY / max) * 100 : 0;
          strich.style.width = pct + '%';
        };
        window.addEventListener('scroll', updateStrich, { passive: true });
        updateStrich();

        if (!bar) return;
        const show = () => {
          bar.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
          bar.setAttribute('aria-hidden', 'false');
        };
        const hide = () => {
          bar.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
          bar.setAttribute('aria-hidden', 'true');
        };
        window.addEventListener('scroll', () => {
          if (window.scrollY > 400) show(); else hide();
        }, { passive: true });
      })();

      // Aufklappmenü schließen, sobald daneben oder Escape geklickt wird —
      // <details> allein bliebe sonst offen stehen.
      document.addEventListener('click', (ereignis) => {
        document.querySelectorAll('details.menue[open]').forEach((menue) => {
          if (!menue.contains(ereignis.target)) menue.removeAttribute('open');
        });
      });
      document.addEventListener('keydown', (ereignis) => {
        if (ereignis.key !== 'Escape') return;
        document.querySelectorAll('details.menue[open]').forEach((menue) => menue.removeAttribute('open'));
      });

      // Jeder Angebots-CTA meldet, welche Stufe angeklickt wurde. Feuert nur,
      // wenn nach Einwilligung tatsächlich ein Tracker geladen ist (Consent
      // Mode v2) — vorher existieren gtag/fbq schlicht nicht.
      document.addEventListener('click', (ereignis) => {
        const tarifZiel = ereignis.target.closest?.('[data-tarif-cta]');
        if (tarifZiel) {
          const tarif = tarifZiel.getAttribute('data-tarif-cta');
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'select_item', { item_list_name: 'angebote', item_id: tarif });
          }
          if (typeof window.fbq === 'function') {
            window.fbq('track', 'InitiateCheckout', { content_name: tarif });
          }
        }

        // Jeder Link zur Kontaktseite ist ein Kontaktversuch, auch ohne dass
        // dort ein Formular abgeschickt wird — separat vom `generate_lead`,
        // das die Formulare selbst bei tatsächlichem Absenden feuern.
        const kontaktZiel = ereignis.target.closest?.('[data-contact-cta]');
        if (kontaktZiel) {
          const quelle = kontaktZiel.getAttribute('data-contact-cta');
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'contact', { method: quelle });
          }
          if (typeof window.fbq === 'function') {
            window.fbq('track', 'Contact', { content_name: quelle });
          }
        }
      });
    </script>
  </body>
</html>
