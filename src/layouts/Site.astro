---
import '../styles/global.css';
import SeoHead from '@justinguese/astro-kit/SeoHead.astro';
import Consent from '@justinguese/astro-kit/Consent.astro';
import CookieBanner from '@justinguese/astro-kit/CookieBanner.astro';
import StickyCta from '@justinguese/astro-kit/StickyCta.astro';
import Attribution from '@justinguese/astro-kit/Attribution.astro';
import FunnelTracking from '@justinguese/astro-kit/FunnelTracking.astro';
import { organizationSchema } from '@justinguese/astro-kit/lib/seo';
import { site } from '../config/site';
import { KONTINGENT, frei } from '../lib/kontingent';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Setzt og:type=article und die Artikel-Metadaten. */
  artikel?: { veroeffentlicht?: string; geaendert?: string; kategorie?: string };
}

const {
  title = 'Nachweis — die KI-Schnittstelle, die Ihrem Datenschutzbeauftragten die Freigabe schreibt',
  description = 'Sidecar-Prüfspur über Ihre bestehende KI — oder gehostete EU-Inferenz. Exportierbare, hash-verkettete Beweiskette für Datenschutzbeauftragte und Betriebsrat. Kein US-Fallback, kein Training auf Ihren Daten.',
  noindex = false,
  artikel,
} = Astro.props;

/** Ratgeber ist ein Aufklappmenü; alle anderen Einträge sind einfache Links. */
const nav: { href: string; label: string; kinder?: { href: string; label: string; kurz: string }[] }[] = [
  { href: '/playground', label: 'Playground' },
  { href: '/eu-inferenz', label: 'EU-Inferenz' },
  {
    href: '/ratgeber',
    label: 'Ratgeber',
    kinder: [
      { href: '/ratgeber/chatgpt-kanzlei-datenschutz', label: 'ChatGPT in der Kanzlei', kurz: 'Was § 203 StGB Anwälten verbietet' },
      { href: '/ratgeber/chatgpt-steuerberater', label: 'ChatGPT für Steuerberater', kurz: 'Mandantendaten, DSGVO und § 203' },
      { href: '/ratgeber/ki-arztpraxis-datenschutz', label: 'KI in der Arztpraxis', kurz: 'Art. 9 DSGVO und Patientendaten' },
      { href: '/ratgeber/avv-ki-anbieter', label: 'AVV für KI-Anbieter', kurz: 'Was nach Art. 28 DSGVO drinstehen muss' },
      { href: '/ratgeber/verarbeitungsverzeichnis-ki', label: 'KI im Verarbeitungsverzeichnis', kurz: 'Der Art. 30-Eintrag, Feld für Feld' },
      { href: '/ratgeber/dsgvo-konforme-ki-alternativen', label: 'DSGVO-konforme KI-Alternativen', kurz: 'EU-gehostete Modelle im Vergleich' },
    ],
  },
  { href: '/unterlagen', label: 'Unterlagen' },
];
/**
 * EU-KI-Recht, Integrationen und Preise bewusst nicht in der Kopfzeile:
 * die auf jeder Sektion sichtbare Navigation soll nicht mit dem einen CTA
 * konkurrieren, den der Seitenkörper konsequent wiederholt. Alle drei
 * bleiben erreichbar — inline auf der Startseite und im Footer. EU-Inferenz
 * ist die eine bewusste Ausnahme — der Eskalationspfad soll auch von jeder
 * Unterseite aus in einem Klick erreichbar sein, nicht nur von der Startseite.
 */
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Martian+Mono:wght@600;700&family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <SeoHead
      title={title}
      description={description}
      siteName={site.name}
      locale={site.locale}
      ogType={artikel ? 'article' : 'website'}
      image="/og-image.svg"
      noindex={noindex}
      article={{
        publishedTime: artikel?.veroeffentlicht,
        modifiedTime: artikel?.geaendert,
        section: artikel?.kategorie,
      }}
      schemas={[organizationSchema({
        name: site.name,
        legalName: site.legalName,
        url: `${site.url}/`,
        description: site.description,
        address: site.address,
        areaServed: site.areaServed,
        logo: `${site.url}/og-image.svg`,
      })]}
    />

    <slot name="head" />

    <!-- Muss vor allem stehen, das gtag berührt. -->
    <Consent ga4Id={site.ga4Id} metaPixelId={site.metaPixelId} />
  </head>
  <body class="bg-canvas text-ink font-sans antialiased flex flex-col min-h-screen">
    <div class="kette-strich" id="kette-strich"></div>

    <header class="border-b border-line py-3.5 relative z-50 bg-canvas/95 backdrop-blur">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center gap-4">
        <a href="/" class="flex items-center gap-2.5 group shrink-0">
          <span class="inline-flex h-8 w-8 items-center justify-center bg-ink text-canvas font-mono text-xs font-bold">K</span>
          <span class="font-display text-[15px] font-bold tracking-tight text-ink" style="font-variation-settings: 'wdth' 90;">
            konforme-ki<span class="text-accent">.de</span>
          </span>
        </a>

        <div class="hidden lg:flex items-center gap-6 text-sm text-ink-soft">
          {/*
            Aufklappmenü ohne JS: <details> öffnet per Klick und ist per
            Tastatur bedienbar. Ein reines :hover-Menü wäre auf Touch-Geräten
            nicht erreichbar.
          */}
          {nav.map((item) => (item.kinder ? (
            <details class="menue relative">
              <summary class="flex items-center gap-1.5 cursor-pointer list-none hover:text-ink transition-colors">
                {item.label}
                <svg class="h-3 w-3 transition-transform" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                </svg>
              </summary>
              <div class="menue-tafel absolute left-1/2 -translate-x-1/2 top-full mt-3 w-[22rem] border border-line bg-surface shadow-[var(--shadow-karte-hoch)]">
                <a href={item.href} class="block px-5 py-3.5 border-b border-line hover:bg-canvas-deep transition-colors">
                  <span class="marginalie">Alle Ratgeber</span>
                  <span class="mt-1 block text-sm font-semibold text-ink">Übersicht ansehen →</span>
                </a>
                {item.kinder.map((kind) => (
                  <a href={kind.href} class="block px-5 py-3 border-b border-line last:border-b-0 hover:bg-canvas-deep transition-colors">
                    <span class="block text-sm font-semibold text-ink">{kind.label}</span>
                    <span class="mt-0.5 block text-xs text-ink-faint leading-snug">{kind.kurz}</span>
                  </a>
                ))}
              </div>
            </details>
          ) : (
            <a href={item.href} class="hover:text-ink transition-colors">{item.label}</a>
          )))}
        </div>

        <a href="/?tarif=compliance#zugang" class="knopf knopf-accent !py-2 !px-3 sm:!px-4 !text-sm shrink-0" data-cta="header">
          <!-- Auf sehr schmalen Geräten würde die Langform Kopfzeile und Seite
               horizontal aufschieben; unten steht ohnehin die Sticky-Leiste. -->
          <span class="sm:hidden">Zugang</span>
          <span class="hidden sm:inline">Zugangsschlüssel sichern</span>
        </a>
      </nav>
    </header>

    <main class="flex-grow">
      <slot name="kette" />
      <slot />
    </main>

    <footer class="bg-canvas-deep border-t border-line py-10 mt-12 kein-druck">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-8 text-sm">
          <div>
            <span class="font-display text-sm font-bold text-ink" style="font-variation-settings: 'wdth' 90;">konforme-ki<span class="text-accent">.de</span></span>
            <p class="mt-3 text-ink-faint leading-relaxed">Prüfspur über Ihre bestehende KI oder gehostete EU-Inferenz.</p>
          </div>
          <div>
            <p class="marginalie mb-3">Produkt</p>
            <div class="flex flex-col gap-2 text-ink-soft">
              <a href="/playground" class="hover:text-ink">Playground</a>
              <a href="/integrationen" class="hover:text-ink">Integrationen</a>
              <a href="/preise" class="hover:text-ink">Preise</a>
              <a href="/eu-inferenz" class="hover:text-ink">EU-Inferenz</a>
            </div>
          </div>
          <div>
            <p class="marginalie mb-3">Recht &amp; Nachweis</p>
            <div class="flex flex-col gap-2 text-ink-soft">
              <a href="/eu-ki-recht" class="hover:text-ink">EU-KI-Recht</a>
              <a href="/unterlagen" class="hover:text-ink">Unterlagen</a>
              <a href="/kontakt" class="hover:text-ink" data-contact-cta="footer">Kontakt</a>
            </div>
          </div>
          <div>
            <p class="marginalie mb-3">Ratgeber</p>
            <div class="flex flex-col gap-2 text-ink-soft">
              {nav.find((n) => n.href === '/ratgeber')?.kinder?.slice(0, 4).map((kind) => (
                <a href={kind.href} class="hover:text-ink">{kind.label}</a>
              ))}
              <a href="/ratgeber" class="text-accent hover:underline">Alle Ratgeber →</a>
            </div>
          </div>
          <div>
            <p class="marginalie mb-3">Rechtliches</p>
            <div class="flex flex-col gap-2 text-ink-soft">
              <a href="/impressum" class="hover:text-ink">Impressum</a>
              <a href="/datenschutz" class="hover:text-ink">Datenschutzerklärung</a>
              <a href="/agb" class="hover:text-ink">AGB</a>
              <a href="/rdg-hinweis" class="hover:text-ink">RDG-Hinweis</a>
              <button type="button" data-consent-reopen class="text-left hover:text-ink cursor-pointer underline-offset-4 hover:underline">
                Cookie-Einstellungen
              </button>
            </div>
          </div>
        </div>
        <p class="mt-10 font-mono text-xs text-ink-faint">&copy; {new Date().getFullYear()} DataFortress.cloud GmbH — Gewerbestraße 13, 82064 Straßlach-Dingharting</p>
      </div>
    </footer>

    <CookieBanner
      privacyHref={site.privacyHref}
      strings={{
        message: 'Wir verwenden Cookies für Reichweitenmessung und Werbeanzeigen erst nach Ihrer Zustimmung. Details in unserer',
        privacyLinkLabel: 'Datenschutzerklärung',
        acceptLabel: 'Alle akzeptieren',
        declineLabel: 'Alle ablehnen',
        regionLabel: 'Cookie-Einwilligung',
      }}
    />

    <StickyCta
      href="/?tarif=compliance#zugang"
      cta="sticky"
      strings={{ note: `Noch ${frei} von ${KONTINGENT.plaetze} Zugangsschlüsseln diesen Monat frei`, ctaLabel: 'Zugangsschlüssel sichern' }}
      hideNear={['zugang', 'angebote']}
    />

    <Attribution storageKey="nw_attribution" />
    <FunnelTracking />

    <script is:inline>
      (() => {
        const strich = document.getElementById('kette-strich');

        const updateStrich = () => {
          if (!strich) return;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const pct = max > 0 ? (window.scrollY / max) * 100 : 0;
          strich.style.width = pct + '%';
        };
        window.addEventListener('scroll', updateStrich, { passive: true });
        updateStrich();
      })();

      // Aufklappmenü schließen, sobald daneben oder Escape geklickt wird —
      // <details> allein bliebe sonst offen stehen.
      document.addEventListener('click', (ereignis) => {
        document.querySelectorAll('details.menue[open]').forEach((menue) => {
          if (!menue.contains(ereignis.target)) menue.removeAttribute('open');
        });
      });
      document.addEventListener('keydown', (ereignis) => {
        if (ereignis.key !== 'Escape') return;
        document.querySelectorAll('details.menue[open]').forEach((menue) => menue.removeAttribute('open'));
      });
    </script>
  </body>
</html>
